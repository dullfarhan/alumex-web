---
interface Props {
	class?: string;
}

const { class: className = 'h-4 w-4' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d="M9 6l6 6-6 6"></path>
</svg>
