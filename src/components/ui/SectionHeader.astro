---
interface Props {
	label?: string;
	title: string;
	description?: string;
	align?: 'center' | 'start';
	class?: string;
}

const { label, title, description, align = 'center', class: className } = Astro.props;
---

<div class:list={[align === 'start' ? 'text-left' : 'text-center', className]}>
	{
		label && (
			<span class="mb-4 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{label}</span>
		)
	}
	<h2
		class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[3.1rem]"
	>
		{title}
	</h2>
	{
		description && (
			<p
				class:list={[
					'text-base leading-relaxed text-muted md:text-lg',
					align === 'center' && 'mx-auto max-w-2xl',
				]}
			>
				{description}
			</p>
		)
	}
</div>
