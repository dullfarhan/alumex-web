---
import ChevronRight from '../icons/ChevronRight.astro';

interface Props {
	label: string;
	desktopClass: string;
	controlsPosition?: 'sides' | 'bottom-right';
	trackId?: string;
}

const { label, desktopClass, controlsPosition = 'sides', trackId } = Astro.props;
---

<div
	class="mobile-carousel"
	data-mobile-carousel
	role="region"
	aria-roledescription="carousel"
	aria-label={label}
>
	<div
		id={trackId}
		class:list={['mobile-carousel__track', desktopClass]}
		data-carousel-track
	>
		<slot />
	</div>

	<div
		class:list={[
			'mobile-carousel__controls',
			controlsPosition === 'bottom-right' && 'mobile-carousel__controls--bottom-right',
		]}
		aria-label={`${label} controls`}
	>
		<button type="button" data-carousel-previous aria-label={`Previous ${label.toLowerCase()}`}>
			<ChevronRight class="h-6 w-6 rotate-180" />
		</button>
		<button type="button" data-carousel-next aria-label={`Next ${label.toLowerCase()}`}>
			<ChevronRight class="h-6 w-6" />
		</button>
	</div>
</div>

<style>
	.mobile-carousel__controls {
		display: none;
	}

	@media (max-width: 639px) {
		.mobile-carousel {
			position: relative;
		}

		.mobile-carousel__track {
			display: flex;
			gap: 1rem;
			overflow-x: auto;
			overscroll-behavior-inline: contain;
			scroll-behavior: smooth;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.mobile-carousel__track::-webkit-scrollbar {
			display: none;
		}

		.mobile-carousel__track > :global(*) {
			width: 100%;
			flex: 0 0 100%;
			scroll-snap-align: start;
			scroll-snap-stop: always;
		}

		.mobile-carousel__controls {
			position: absolute;
			z-index: 10;
			top: 50%;
			right: 0.75rem;
			left: 0.75rem;
			display: flex;
			justify-content: space-between;
			pointer-events: none;
			transform: translateY(-50%);
		}

		.mobile-carousel__controls--bottom-right {
			top: auto;
			right: 1rem;
			bottom: 1rem;
			left: auto;
			justify-content: flex-end;
			gap: 0.5rem;
			transform: none;
		}

		.mobile-carousel__controls button {
			display: inline-flex;
			height: 2.2rem;
			width: 2.2rem;
			align-items: center;
			justify-content: center;
			border: 0;
			border-radius: 9999px;
			background: linear-gradient(135deg, rgb(255 255 255 / 72%), rgb(255 255 255 / 38%));
			color: var(--color-primary);
			cursor: pointer;
			pointer-events: auto;

			-webkit-backdrop-filter: blur(14px) saturate(160%);
			backdrop-filter: blur(14px) saturate(160%);
			touch-action: manipulation;
			transition:
				background-color 200ms,
				box-shadow 200ms,
				color 200ms,
				transform 200ms;
		}

		.mobile-carousel__controls button:hover {
			background: linear-gradient(135deg, rgb(255 255 255 / 84%), rgb(255 255 255 / 48%));
			box-shadow:
				0 10px 28px rgb(18 43 77 / 22%),
				inset 0 1px 0 rgb(255 255 255 / 85%);
		}

		.mobile-carousel__controls button:active {
			transform: scale(0.95);
		}

		.mobile-carousel__controls button:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-carousel__track {
			scroll-behavior: auto;
		}
	}
</style>

<script>
	const mobileQuery = window.matchMedia('(max-width: 639px)');
	const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('[data-mobile-carousel]').forEach((carousel) => {
		if (carousel.dataset.carouselReady === 'true') return;
		carousel.dataset.carouselReady = 'true';

		const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
		const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
		if (!track || !previous || !next) return;

		let originalSlides = Array.from(track.children).filter(
			(el) => !el.hasAttribute('data-carousel-clone') && !el.classList.contains('hidden'),
		) as HTMLElement[];

		let autoplay: ReturnType<typeof setInterval> | undefined;
		let scrollEndTimer: ReturnType<typeof setTimeout> | undefined;
		let edgeClones: HTMLElement[] = [];

		const syncSlides = () => {
			originalSlides = Array.from(track.children).filter(
				(el) => !el.hasAttribute('data-carousel-clone') && !el.classList.contains('hidden'),
			) as HTMLElement[];
		};

		const slides = () => Array.from(track.children) as HTMLElement[];
		const slideOffset = (slide: HTMLElement) => slide.offsetLeft - slides()[0].offsetLeft;

		const activeIndex = () => {
			const currentSlides = slides();
			return currentSlides.reduce(
				(nearest, slide, index) =>
					Math.abs(slideOffset(slide) - track.scrollLeft) <
					Math.abs(slideOffset(currentSlides[nearest]) - track.scrollLeft)
						? index
						: nearest,
				0,
			);
		};

	const goTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
		if (!mobileQuery.matches) return;
		const currentSlides = slides();
		const total = currentSlides.length;
		const targetIndex = edgeClones.length
			? Math.max(0, Math.min(total - 1, index))
			: (index + total) % total;
		const target = currentSlides[targetIndex];
		track.scrollTo({
			left: slideOffset(target),
			behavior: reducedMotionQuery.matches ? 'auto' : behavior,
		});
	};

	const jumpTo = (index: number) => {
		const target = slides()[index];
		track.style.scrollSnapType = 'none';
		track.style.scrollBehavior = 'auto';
		track.scrollLeft = slideOffset(target);
		requestAnimationFrame(() => {
			track.style.removeProperty('scroll-behavior');
			track.style.removeProperty('scroll-snap-type');
		});
	};

	const updateControlsVisibility = () => {
		const controls = carousel.querySelector<HTMLElement>('.mobile-carousel__controls');
		if (!controls) return;
		const show = mobileQuery.matches && originalSlides.length >= 2;
		controls.style.display = show ? '' : 'none';
	};

		const normalizeEdge = () => {
			if (!edgeClones.length || !mobileQuery.matches) return;
			const index = activeIndex();
			const currentSlides = slides();
			if (index === 0) jumpTo(originalSlides.length);
			if (index === currentSlides.length - 1) jumpTo(1);
		};

	const makeClone = (slide: HTMLElement) => {
		const clone = slide.cloneNode(true) as HTMLElement;
		clone.setAttribute('aria-hidden', 'true');
		clone.setAttribute('data-carousel-clone', '');
		clone.querySelectorAll<HTMLElement>('a, button, input, select, textarea, [tabindex]').forEach((item) => {
			item.tabIndex = -1;
			if (item.tagName === 'A') item.removeAttribute('href');
		});
		return clone;
	};

		const addEdgeClones = () => {
			if (edgeClones.length || originalSlides.length < 2) return;
			const lastClone = makeClone(originalSlides.at(-1)!);
			const firstClone = makeClone(originalSlides[0]);
			track.prepend(lastClone);
			track.append(firstClone);
			edgeClones = [lastClone, firstClone];
			requestAnimationFrame(() => jumpTo(1));
		};

		const removeEdgeClones = () => {
			edgeClones.forEach((clone) => clone.remove());
			edgeClones = [];
			track.scrollLeft = 0;
		};

		const stopAutoplay = () => {
			clearInterval(autoplay);
			autoplay = undefined;
		};

	const startAutoplay = () => {
		stopAutoplay();
		if (!mobileQuery.matches || reducedMotionQuery.matches || document.hidden) return;
		if (originalSlides.length < 2) return;
		autoplay = setInterval(() => {
			const idx = activeIndex();
			const total = slides().length;
			if (edgeClones.length && idx >= total - 1) return;
			goTo(idx + 1);
		}, 5000);
	};

		const move = (direction: number) => {
			goTo(activeIndex() + direction);
			startAutoplay();
		};

		previous.addEventListener('click', () => move(-1));
		next.addEventListener('click', () => move(1));
		track.addEventListener('pointerdown', stopAutoplay, { passive: true });
		track.addEventListener('pointerup', startAutoplay, { passive: true });
		track.addEventListener('pointercancel', startAutoplay, { passive: true });
		track.addEventListener(
			'scroll',
			() => {
				clearTimeout(scrollEndTimer);
				scrollEndTimer = setTimeout(normalizeEdge, 100);
			},
			{ passive: true },
		);

	const refresh = () => {
		removeEdgeClones();
		syncSlides();
		updateControlsVisibility();
		if (!mobileQuery.matches) return;
		if (originalSlides.length >= 2) {
			addEdgeClones();
			startAutoplay();
		} else {
			track.scrollLeft = 0;
			stopAutoplay();
		}
	};

	const updateMode = () => {
		if (!mobileQuery.matches) {
			stopAutoplay();
			removeEdgeClones();
			updateControlsVisibility();
			return;
		}
		refresh();
	};

		carousel.addEventListener('carousel:refresh', refresh);
		mobileQuery.addEventListener('change', updateMode);
		reducedMotionQuery.addEventListener('change', startAutoplay);
		document.addEventListener('visibilitychange', startAutoplay);
		updateMode();
	});
</script>
