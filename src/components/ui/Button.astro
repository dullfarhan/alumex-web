---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary';
	size?: 'default' | 'sm';
	class?: string;
}

const { href, variant = 'primary', size = 'default', class: className } = Astro.props;

const base =
	'inline-flex items-center gap-2 rounded-lg border text-sm font-medium transition-[background-color,color,border-color,transform] duration-300 [&_svg]:transition-transform [&_svg]:duration-300 hover:[&_svg]:translate-x-1';

const variants = {
	primary:
		'border-primary-dark bg-primary-dark text-white hover:bg-transparent hover:text-heading',
	secondary:
		'border-primary-dark bg-transparent text-heading hover:bg-primary-dark hover:text-white',
};

const sizes = {
	default: 'px-4 py-2.5 sm:px-6 sm:py-3 ',
	sm: 'px-4 py-2.5 sm:px-5 sm:py-2.5',
};
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]}>
	<slot />
</a>
