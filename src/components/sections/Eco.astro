---
import { eco } from '../../config/eco';
import Container from '../layout/Container.astro';
---

<section id="eco" class="bg-background py-24 md:py-32">
	<Container>
		<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="overflow-hidden rounded-xl">
				<img src={eco.image} alt="Eco friendly aluminium manufacturing" class="aspect-[4/3] w-full object-cover" />
			</div>

			<div>
				<span class="mb-4 block text-xs font-medium tracking-[0.08em] text-primary uppercase">{eco.label}</span>
				<h2 class="mb-4 font-display text-4xl leading-[1.1] font-bold tracking-tight text-heading md:text-5xl">
					{eco.title}
				</h2>
				<p class="mb-10 text-lg leading-relaxed text-muted">{eco.description}</p>

				<ul class="space-y-6">
					{
						eco.points.map((point) => (
							<li class="border-t border-silver/60 pt-6">
								<h3 class="mb-1 font-display text-lg font-bold text-heading">{point.title}</h3>
								<p class="text-sm leading-relaxed text-muted">{point.description}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</Container>
</section>
