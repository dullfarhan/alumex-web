---
import { Image } from 'astro:assets';
import { eco } from '../../config/eco';
import Container from '../layout/Container.astro';
---

<section id="eco" class="bg-background">
	<Container>
		<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
			<div class="overflow-hidden rounded-xl">
				<Image
					src={eco.image}
					alt="Eco friendly aluminium manufacturing"
					widths={[640, 960, 1200]}
					sizes="(max-width: 1024px) 100vw, 50vw"
					class="aspect-[4/3] w-full object-cover"
				/>
			</div>

			<div>
				<span class="mb-6 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{eco.label}</span>
				<h2 class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl lg:text-[3.1rem]">
					{eco.title}
				</h2>
				<p class="mb-4 text-lg leading-relaxed text-muted">{eco.description}</p>

				<ul class="space-y-6">
					{
						eco.points.map((point) => (
							<li class="border-t border-silver/60 pt-6">
								<h3 class="mb-1 font-display text-lg font-bold text-heading">{point.title}</h3>
								<p class="text-sm leading-relaxed text-muted">{point.description}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</Container>
</section>
