---
import { Image } from 'astro:assets';
import { eco } from '../../config/eco';
import Container from '../layout/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="eco" class="bg-background">
	<Container>
		<div class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-12">
			<div class="h-full min-h-64 overflow-hidden rounded-xl lg:min-h-0">
				<Image
					src={eco.image}
					alt="Eco friendly aluminium manufacturing"
					widths={[640, 960, 1200]}
					sizes="(max-width: 1024px) 100vw, 50vw"
					class="h-full w-full object-cover"
				/>
			</div>

			<div>
				<SectionHeader
					label={eco.label}
					title={eco.title}
					description={eco.description}
					align="start"
					class="mb-4"
				/>

				<ul class="mt-6 space-y-5" data-anim-stagger>
					{
						eco.points.map((point) => (
							<li class="border-t border-silver/60 pt-5 flex flex-col gap-1">
								<h3 class="font-display text-lg font-bold text-heading">{point.title}</h3>
								<p class="text-sm leading-relaxed text-muted">{point.description}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</Container>
</section>
