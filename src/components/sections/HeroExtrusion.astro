<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const touchUi = matchMedia("(hover: none) and (pointer: coarse)").matches;

	const section = document.querySelector<HTMLElement>("[data-hero]");
	const runway = section?.querySelector<HTMLElement>("[data-hero-runway]");
	const stage = section?.querySelector<HTMLElement>("[data-hero-stage]");
	const doorScene = section?.querySelector<HTMLElement>(
		'[data-hero-scene="door"]',
	);
	const windowScene = section?.querySelector<HTMLElement>(
		'[data-hero-scene="window"]',
	);
	const captions = section
		? Array.from(
				section.querySelectorAll<HTMLElement>("[data-hero-caption]"),
			)
		: [];
	const leftSash = section?.querySelector<HTMLElement>(
		'[data-hero-sash="left"]',
	);
	const reducedMotion = matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (section && runway && stage && doorScene && windowScene && leftSash) {
		const pick = <T extends Element>(selector: string) =>
			Array.from(section.querySelectorAll<T>(selector));

		const bars = pick<HTMLElement>("[data-hero-bar]");
		const doors = pick<HTMLElement>("[data-hero-door]");
		const windowRails = pick<HTMLElement>("[data-hero-window-rail]");
		const windowTrack = section.querySelector<HTMLElement>(
			"[data-hero-window-track]",
		);
		const sashes = pick<HTMLElement>("[data-hero-sash]");
		const sashHandles = pick<HTMLElement>("[data-hero-sash-handle]");
		const marquee = section.querySelector<HTMLElement>(
			"[data-hero-marquee]",
		);
		const eyebrow = section.querySelector<HTMLElement>(
			"[data-hero-eyebrow]",
		);

		gsap.set('[data-hero-door="left"]', { transformOrigin: "left center" });
		gsap.set('[data-hero-door="right"]', {
			transformOrigin: "right center",
		});
		gsap.set(leftSash, { xPercent: 0, x: 0, y: 0, z: 0, force3D: touchUi });
		gsap.set([doorScene, windowScene], { rotateX: 1, rotateY: 0 });

		const buildReveal = (scrollConfig: Record<string, unknown>) => {
			const reveal = gsap.timeline({
				defaults: { ease: "none" },
				scrollTrigger: scrollConfig,
			});

			reveal
				.fromTo(
					'[data-hero-door="left"]',
					{ rotateY: 0 },
					{
						rotateY: -95,
						duration: 0.9,
						ease: "none",
						force3D: touchUi,
					},
					0.05,
				)
				.fromTo(
					'[data-hero-door="right"]',
					{ rotateY: 0 },
					{
						rotateY: 95,
						duration: 0.9,
						ease: "none",
						force3D: touchUi,
					},
					0.05,
				)
				.fromTo(
					leftSash,
					{ xPercent: 0, force3D: touchUi },
					{
						xPercent: 94,
						force3D: touchUi,
						duration: 0.9,
						ease: "none",
					},
					0.05,
				)
				.to(captions, { opacity: 1, duration: 0.4 }, 0.05);

			return reveal;
		};

		if (reducedMotion) {
			gsap.set('[data-hero-door="left"]', { rotateY: -95 });
			gsap.set('[data-hero-door="right"]', { rotateY: 95 });
			gsap.set(leftSash, { xPercent: 94, force3D: false });
			gsap.set(captions, { opacity: 1 });
		} else {
			/* Opening act, on load */
			const intro = gsap.timeline({ defaults: { ease: "power3.out" } });

			intro
				.fromTo(
					"[data-hero-logo]",
					{ opacity: 0, scale: 0.85 },
					{ opacity: 1, scale: 1, duration: 0.7 },
				)
				.fromTo(
					".hero__slogan-ring",
					{ opacity: 0 },
					{ opacity: 1, duration: 0.55 },
					"-=0.35",
				);

			if (eyebrow) {
				intro.fromTo(
					eyebrow,
					{ opacity: 0, y: 12 },
					{ opacity: 1, y: 0, duration: 0.45 },
					"-=0.2",
				);
			}

			intro
				.fromTo(
					"[data-hero-line]",
					{ yPercent: 115, opacity: 0 },
					{ yPercent: 0, opacity: 1, duration: 1, stagger: 0.1 },
					"-=0.15",
				)
				.fromTo(
					"[data-hero-fade]",
					{ opacity: 0, y: 20 },
					{ opacity: 1, y: 0, duration: 0.7, stagger: 0.12 },
					"-=0.5",
				)
				.fromTo(
					marquee,
					{ opacity: 0, y: 16 },
					{ opacity: 1, y: 0, duration: 0.7 },
					"-=0.4",
				)
				.fromTo(
					bars,
					{ opacity: 0, scale: 0.6 },
					{ opacity: 1, scale: 1, duration: 0.6, stagger: 0.08 },
					0.4,
				);

			const windowFrameParts = windowTrack
				? [...windowRails, windowTrack]
				: windowRails;

			if (windowFrameParts.length) {
				intro.fromTo(
					windowFrameParts,
					{ opacity: 0, scale: 0.6 },
					{ opacity: 1, scale: 1, duration: 0.6, stagger: 0.08 },
					0.4,
				);
			}

			intro
				.fromTo(
					doors,
					{ opacity: 0 },
					{ opacity: 1, duration: 0.7, stagger: 0.12 },
					"-=0.3",
				)
				.fromTo(
					sashes,
					{ opacity: 0 },
					{ opacity: 1, duration: 0.7, stagger: 0.12 },
					"-=0.3",
				)
				.fromTo(
					"[data-hero-handle]",
					{ opacity: 0, scale: 0 },
					{ opacity: 1, scale: 1, duration: 0.5 },
					"-=0.3",
				)
				.fromTo(
					sashHandles,
					{ opacity: 0, scale: 0 },
					{ opacity: 1, scale: 1, duration: 0.5 },
					"-=0.3",
				)
				.fromTo(
					captions,
					{ opacity: 0 },
					{ opacity: 0.5, duration: 0.5 },
					"-=0.3",
				);

			/* Reveal act — same sequence/easing, one-shot on touch, scrubbed on desktop */
			const buildRevealOneShot = () => {
				const reveal = gsap.timeline({ defaults: { ease: "power2.inOut" } });
				reveal
					.fromTo(
						'[data-hero-door="left"]',
						{ rotateY: 0 },
						{ rotateY: -95, duration: 1.4, force3D: touchUi },
						0.05,
					)
					.fromTo(
						'[data-hero-door="right"]',
						{ rotateY: 0 },
						{ rotateY: 95, duration: 1.4, force3D: touchUi },
						0.05,
					)
					.fromTo(
						leftSash,
						{ xPercent: 0, force3D: touchUi },
						{ xPercent: 94, duration: 1.4, force3D: touchUi },
						0.05,
					)
					.to(
						captions,
						{ opacity: 1, duration: 0.4, ease: "power2.out" },
						0.05,
					);
				reveal.pause();
				return reveal;
			};

			ScrollTrigger.matchMedia({
				/* Touch: no pin, no scrub — plays once when the hero enters view */
				"(max-width: 1023px)": () => {
					const reveal = buildRevealOneShot();
					const play = () => intro.then(() => reveal.play());
					ScrollTrigger.create({
						trigger: runway,
						start: "top top",
						once: true,
						onEnter: play,
					});
					/* Hero sits at the document top — start even if the trigger
					   was already active before its first refresh (idempotent) */
					if (window.scrollY < window.innerHeight) play();
					return () => reveal.kill();
				},
				/* Desktop: scrubbed against the sticky stage (unchanged) */
				"(min-width: 1024px)": () => {
					buildReveal({
						trigger: runway,
						start: "top top",
						end: "bottom bottom",
						scrub: 0.25,
					});
				},
			});

			/* Touch: pause the marquee while the hero is off-screen */
			if (touchUi) {
				const marqueeTrack = section.querySelector<HTMLElement>(
					"[data-hero-marquee] .hero__marquee-track",
				);
				ScrollTrigger.create({
					trigger: section,
					start: "top bottom",
					end: "bottom top",
					onToggle: (self) => {
						marqueeTrack?.classList.toggle("is-paused", !self.isActive);
					},
				});
			}

			/* Pointer-driven 3D camera tilt — desktop only */
			if (!touchUi) {
				const doorTiltY = gsap.quickTo(doorScene, "rotateY", {
					duration: 0.8,
					ease: "power3",
				});
				const doorTiltX = gsap.quickTo(doorScene, "rotateX", {
					duration: 0.8,
					ease: "power3",
				});
				const windowTiltY = gsap.quickTo(windowScene, "rotateY", {
					duration: 0.8,
					ease: "power3",
				});
				const windowTiltX = gsap.quickTo(windowScene, "rotateX", {
					duration: 0.8,
					ease: "power3",
				});

				stage.addEventListener("pointermove", (event) => {
					if (event.pointerType !== "mouse") return;
					const x = event.clientX / window.innerWidth - 0.5;
					const y = event.clientY / window.innerHeight - 0.5;
					doorTiltY(x * 3);
					doorTiltX(1 + y * -2);
					windowTiltY(x * 3);
					windowTiltX(1 + y * -2);
				});

				stage.addEventListener("pointerleave", () => {
					doorTiltY(0);
					doorTiltX(1);
					windowTiltY(0);
					windowTiltX(1);
				});
			}
		}
	}
</script>
