---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { hero } from "../../config/hero";
import { productItems } from "../../config/products";
import { projectItems } from "../../config/projects";
import logo from "../../assets/logo.png";
import ArrowRight from "../icons/ArrowRight.astro";
import DownloadIcon from "../icons/DownloadIcon.astro";
import Button from "../ui/Button.astro";

const titleLines = ["Engineering Aluminium for Modern Architecture."];

const galleryPool: { src: ImageMetadata; alt: string; href?: string }[] = [
	...productItems.map((item) => ({
		src: item.image,
		alt: item.title,
	})),
	...projectItems.map((item) => ({
		src: item.image,
		alt: item.title,
		href: item.href,
	})),
];

/* Stable shuffle so products and projects mix in the marquee */
const galleryItems = galleryPool
	.map((item, i) => ({ item, sort: (i * 17 + 11) % 31 }))
	.sort((a, b) => a.sort - b.sort)
	.map(({ item }) => item);

const marqueeItems = [...galleryItems, ...galleryItems];
---

<section class="hero" data-hero aria-label="Alumex hero">
	<div class="hero__runway" data-hero-runway>
		<div class="hero__stage" data-hero-stage>
			<div class="hero__grid-bg" data-hero-bg aria-hidden="true"></div>
			<div class="hero__vignette" aria-hidden="true"></div>

			<div class="hero__inner">
				<div class="hero__copy">
					<div class="hero__brand" data-hero-brand>
						<div class="hero__logo" data-hero-logo>
							<Image
								src={logo}
								alt="Alumex"
								width={256}
								height={256}
								densities={[1, 2]}
								sizes="(min-width: 1024px) 10.5rem, (min-width: 768px) 9rem, 7.5rem"
								loading="eager"
								fetchpriority="high"
								decoding="async"
								class="hero__logo-img"
								draggable="false"
							/>
							<svg
								class="hero__slogan-ring"
								viewBox="0 0 200 200"
								role="img"
								aria-label="Towards a better future"
							>
								<title>Towards a better future</title>
								<defs>
									<!-- True circle just outside the emblem -->
									<path
										id="hero-slogan-arc"
										d="M 100 12 A 88 88 0 1 1 99.999 12"
										fill="none"></path>
								</defs>
								<text class="hero__slogan-text">
									<textPath
										href="#hero-slogan-arc"
										startOffset="50%"
										text-anchor="middle"
									>
										Towards a better future
									</textPath>
								</text>
							</svg>
						</div>
					</div>

					<p class="hero__eyebrow" data-hero-eyebrow>{hero.label}</p>

					<h1 class="hero__title">
						{
							titleLines.map((line) => (
								<span class="hero__line">
									<span
										class="hero__line-inner"
										data-hero-line
									>
										{line}
									</span>
								</span>
							))
						}
					</h1>

					<div data-hero-trail>
						<p class="hero__description" data-hero-fade>
							{hero.description}
						</p>

						<div class="hero__actions" data-hero-fade>
							<Button
								href={hero.primaryCta.href}
								class="!rounded-full"
							>
								{hero.primaryCta.label}
								<ArrowRight class="h-4 w-4" />
							</Button>
							<Button
								href={hero.secondaryCta.href}
								download={hero.secondaryCta.download}
								variant="secondary"
								class="!rounded-full"
							>
								<DownloadIcon class="h-4 w-4" />
								{hero.secondaryCta.label}
							</Button>
						</div>
					</div>
				</div>

				<div class="hero__visual">
					<div class="hero__visual-grid">
						<div class="hero3d-panel" data-hero-panel="door">
							<div class="hero3d" data-hero3d="door">
								<div
									class="hero3d__scene hero3d__scene--door"
									data-hero-scene="door"
								>
									<div class="hero3d__assembly">
										<div
											class="hero3d__portal"
											data-hero-portal
										>
											<div
												class="hero3d__frame"
												data-hero-frame
											>
												<div
													class="hero3d__bar hero3d__bar--top"
													data-hero-bar
												>
												</div>
												<div
													class="hero3d__bar hero3d__bar--bottom"
													data-hero-bar
												>
												</div>
												<div
													class="hero3d__bar hero3d__bar--left"
													data-hero-bar
												>
												</div>
												<div
													class="hero3d__bar hero3d__bar--right"
													data-hero-bar
												>
												</div>
											</div>

											<div
												class="hero3d__door hero3d__door--left"
												data-hero-door="left"
											>
												<div class="hero3d__door-front">
													<div class="hero3d__glass">
													</div>
													<div
														class="hero3d__glass-sheen"
													>
													</div>
												</div>
												<div class="hero3d__door-edge">
												</div>
												<div class="hero3d__door-back">
												</div>
												<span
													class="hero3d__hinge hero3d__hinge--1"
													aria-hidden="true"></span>
												<span
													class="hero3d__hinge hero3d__hinge--2"
													aria-hidden="true"></span>
												<span
													class="hero3d__hinge hero3d__hinge--3"
													aria-hidden="true"></span>
												<div
													class="hero3d__handle"
													data-hero-handle
												>
													<span
														class="hero3d__handle-cap"
													></span>
												</div>
											</div>

											<div
												class="hero3d__door hero3d__door--right"
												data-hero-door="right"
											>
												<div class="hero3d__door-front">
													<div class="hero3d__glass">
													</div>
													<div
														class="hero3d__glass-sheen"
													>
													</div>
												</div>
												<div class="hero3d__door-edge">
												</div>
												<div class="hero3d__door-back">
												</div>
												<span
													class="hero3d__hinge hero3d__hinge--1"
													aria-hidden="true"></span>
												<span
													class="hero3d__hinge hero3d__hinge--2"
													aria-hidden="true"></span>
												<span
													class="hero3d__hinge hero3d__hinge--3"
													aria-hidden="true"></span>
												<div
													class="hero3d__handle"
													data-hero-handle
												>
													<span
														class="hero3d__handle-cap"
													></span>
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="hero3d__floor" aria-hidden="true">
								</div>
							</div>
							<p class="hero__caption" data-hero-caption="door">
								Opening door
							</p>
						</div>

						<div class="hero3d-panel" data-hero-panel="window">
							<div class="hero3d" data-hero3d="window">
								<div
									class="hero3d__scene hero3d__scene--window"
									data-hero-scene="window"
								>
									<div class="hero3d__assembly">
										<div
											class="hero3d__window"
											data-hero-window
										>
											<div class="hero3d__window-opening">
												<div
													class="hero3d__window-track"
													data-hero-window-track
													aria-hidden="true"
												>
												</div>

												<div
													class="hero3d__sash hero3d__sash--right"
													data-hero-sash="right"
												>
													<div
														class="hero3d__sash-body"
													>
														<div
															class="hero3d__sash-glass"
														>
														</div>
														<div
															class="hero3d__sash-sheen"
														>
														</div>
													</div>
												</div>

												<div
													class="hero3d__sash hero3d__sash--left"
													data-hero-sash="left"
												>
													<div
														class="hero3d__sash-body"
													>
														<div
															class="hero3d__sash-glass"
														>
														</div>
														<div
															class="hero3d__sash-sheen"
														>
														</div>
													</div>
													<span
														class="hero3d__sash-handle"
														data-hero-sash-handle
														aria-hidden="true"
													></span>
													<span
														class="hero3d__sash-lock"
														data-hero-sash-handle
														aria-hidden="true"
													></span>
												</div>
											</div>

											<div
												class="hero3d__window-frame"
												aria-hidden="true"
											>
												<span
													class="hero3d__window-rail hero3d__window-rail--top"
													data-hero-window-rail
												></span>
												<span
													class="hero3d__window-rail hero3d__window-rail--bottom"
													data-hero-window-rail
												></span>
												<span
													class="hero3d__window-rail hero3d__window-rail--left"
													data-hero-window-rail
												></span>
												<span
													class="hero3d__window-rail hero3d__window-rail--right"
													data-hero-window-rail
												></span>
											</div>
										</div>
									</div>
								</div>
								<div class="hero3d__floor" aria-hidden="true">
								</div>
							</div>
							<p class="hero__caption" data-hero-caption="window">
								Sliding sash
							</p>
						</div>
					</div>
				</div>
			</div>

			<div
				class="hero__marquee"
				data-hero-marquee
				aria-label="Product and project gallery"
			>
				<div class="hero__marquee-track">
					{
						marqueeItems.map((item, index) => {
							const hidden = index >= galleryItems.length;
							const image = (
								<Image
									src={item.src}
									alt={item.alt}
									widths={[240, 360, 480]}
									sizes="10rem"
									class="hero__marquee-img"
									loading={index < 6 ? "eager" : "lazy"}
									draggable="false"
								/>
							);
							return item.href ? (
								<a
									href={item.href}
									class="hero__marquee-card"
									tabindex={hidden ? -1 : undefined}
									aria-hidden={hidden ? "true" : undefined}
								>
									{image}
								</a>
							) : (
								<div
									class="hero__marquee-card"
									aria-hidden={hidden ? "true" : undefined}
								>
									{image}
								</div>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		overflow-x: clip;
		background: radial-gradient(
			ellipse at 70% 40%,
			#f4f8fc 0%,
			#eaf1f8 55%,
			#dde7f1 100%
		);
	}

	.hero__runway {
		height: 125vh;
	}

	@media (max-width: 1023px) {
		/* One-shot reveal on touch — stage fills the runway, native scroll */
		.hero__runway {
			height: auto;
		}
	}

	.hero__stage {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
		gap: 0.5rem;
		padding-bottom: 0.5rem;
	}

	@media (max-width: 1023px) {
		/* No pin on touch — stage stays in normal flow, iOS momentum scroll native */
		.hero__stage {
			position: relative;
		}
	}

	@media (min-width: 400px) {
		.hero__stage {
			gap: 0.85rem;
		}
	}

	@media (min-width: 640px) {
		.hero__stage {
			gap: 1.25rem;
			padding-bottom: 0.75rem;
		}
	}

	.hero__grid-bg {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(to right, rgb(31 78 140 / 6%) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(31 78 140 / 6%) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(
			ellipse at 68% 45%,
			black 8%,
			transparent 70%
		);
	}

	.hero__vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			ellipse at 50% 55%,
			transparent 50%,
			rgb(18 43 77 / 10%) 100%
		);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: grid;
		width: 100%;
		max-width: 1440px;
		flex: 0 1 auto;
		min-height: 0;
		margin-inline: auto;
		gap: 0.35rem;
		padding: 2.5rem 1.25rem 0;
		align-items: stretch;
		grid-template-rows: 1fr auto;
	}
	@media (min-width: 400px) {
		.hero__inner {
			gap: 0.75rem;
		}
	}
	@media (min-width: 640px) {
		.hero__inner {
			gap: 1.25rem;
		}
	}
	@media (min-width: 768px) {
		.hero__inner {
			padding: 5.5rem 1.25rem 0;
		}
	}
	@media (min-width: 1024px) {
		.hero__inner {
			grid-template-columns: 6fr 6fr;
			grid-template-rows: none;
			gap: 4rem;
			padding: 4rem 3rem 0;
			align-items: center;
		}
		.hero__stage {
			gap: 5rem;
		}
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		min-height: 0;
		gap: 0;
	}

	@media (min-width: 1024px) {
		.hero__copy {
			align-items: flex-start;
			text-align: left;
		}
	}

	.hero__eyebrow {
		font-family: var(--font-display);
		font-size: 0.525rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--primary);
	}

	@media (max-width: 1023px) {
		.hero__eyebrow {
			display: none;
		}
	}

	@media (min-width: 768px) {
		.hero__eyebrow {
			font-size: 0.6875rem;
		}
	}
	@media (min-width: 1024px) {
		.hero__eyebrow {
			margin-top: 0.75rem;
		}
	}

	.hero__title {
		/* max-width: 18ch; */
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 3.5vw, 2.5rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--heading);
	}
	@media (min-width: 768px) {
		.hero__title {
			margin: 0 auto 1rem;
			font-size: clamp(1.875rem, 4.2vw, 3.25rem);
		}
	}
	@media (min-width: 1024px) {
		.hero__title {
			margin-inline: 0;
		}
	}

	.hero__line {
		display: block;
		overflow: hidden;
		/* Room for descenders (g, y) inside the reveal mask */
		padding-bottom: 0.18em;
		margin-bottom: -0.12em;
	}

	.hero__line-inner {
		display: block;
		padding-bottom: 0.06em;
	}

	.hero__line:last-child .hero__line-inner {
		background: var(--brand-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__description {
		max-width: 30rem;
		margin-inline: auto;
		margin-bottom: 0.75rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text);
	}
	@media (min-width: 768px) {
		.hero__description {
			line-height: 1.65;
			font-size: 1.0625rem;
			margin-bottom: 1.5rem;
		}
	}
	@media (min-width: 1024px) {
		.hero__description {
			margin-inline: 0;
		}
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	@media (min-width: 1024px) {
		.hero__actions {
			justify-content: flex-start;
		}
	}

	.hero__marquee {
		position: relative;
		z-index: 1;
		width: 100%;
		flex-shrink: 0;
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent,
			#000 4%,
			#000 96%,
			transparent
		);
	}

	.hero__marquee-track {
		display: flex;
		width: max-content;
		gap: 0.75rem;
		animation: hero-marquee 48s linear infinite;
	}

	.hero__marquee-card {
		display: block;
		flex: 0 0 auto;
		width: 7.5rem;
		overflow: hidden;
		border-radius: 0.65rem;
		box-shadow: 0 8px 20px rgb(18 43 77 / 12%);
		transition: transform 200ms ease;
	}

	@media (min-width: 640px) {
		.hero__marquee-card {
			width: 9rem;
		}
	}

	@media (min-width: 1024px) {
		.hero__marquee-card {
			width: 10rem;
		}
	}

	.hero__marquee-card:hover {
		transform: translateY(-2px);
	}

	.hero__marquee-img {
		display: block;
		aspect-ratio: 5 / 4;
		width: 100%;
		object-fit: cover;
	}

	@keyframes hero-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__marquee-track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
			justify-content: center;
		}

		.hero__marquee-card[aria-hidden="true"] {
			display: none;
		}
	}

	.hero__visual {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		min-width: 0;
		align-self: center;
		margin-top: 1rem;
		width: 100%;
	}

	@media (min-width: 400px) {
		.hero__visual {
			margin-top: 1.15rem;
		}
	}

	@media (min-width: 640px) {
		.hero__visual {
			margin-top: 1.35rem;
		}
	}

	@media (min-width: 1024px) {
		.hero__visual {
			align-self: center;
			justify-content: center;
			margin-top: 0;
		}
	}

	.hero__visual-grid {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		width: fit-content;
		max-width: 100%;
		margin-inline: auto;
	}

	@media (min-width: 400px) {
		.hero__visual-grid {
			gap: 0.85rem;
		}
	}

	@media (min-width: 640px) {
		.hero__visual-grid {
			gap: 1rem;
		}
	}

	@media (min-width: 1024px) {
		.hero__visual-grid {
			display: grid;
			grid-template-columns: 1fr;
			align-items: center;
			justify-items: center;
			gap: 0.5rem;
			width: 100%;
			max-width: 20rem;
			margin-inline: auto;
		}
	}

	.hero3d-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 0 0 auto;
		min-width: 0;
		overflow: visible;
	}

	.hero__brand {
		display: flex;
		justify-content: center;
	}

	@media (min-width: 1024px) {
		.hero__brand {
			justify-content: flex-start;
		}
	}

	.hero__logo {
		position: relative;
		width: 4.25rem;
		aspect-ratio: 1;
	}

	@media (min-width: 400px) {
		.hero__logo {
			width: 5rem;
		}
	}

	@media (min-width: 768px) {
		.hero__logo {
			width: 9rem;
		}
	}

	@media (min-width: 1024px) {
		.hero__logo {
			width: 10.5rem;
		}
	}

	.hero__logo-img {
		position: absolute;
		inset: 14%;
		z-index: 1;
		display: block;
		width: 72%;
		height: 72%;
		border-radius: 50%;
		object-fit: contain;
		filter: drop-shadow(0 14px 32px rgb(18 43 77 / 28%));
		user-select: none;
	}

	.hero__slogan-ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
		rotate: 180deg;
	}

	.hero__slogan-text {
		fill: var(--heading);
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 600;
		text-transform: uppercase;
	}

	.hero__caption {
		display: block;
		margin-top: 0.25rem;
		text-align: center;
		font-family: var(--font-display);
		font-size: 0.5rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--primary);
		opacity: 0.5;
	}

	@media (min-width: 400px) {
		.hero__caption {
			font-size: 0.5625rem;
			letter-spacing: 0.16em;
		}
	}

	@media (min-width: 640px) {
		.hero__caption {
			font-size: 0.625rem;
		}
	}

	@media (min-width: 1024px) {
