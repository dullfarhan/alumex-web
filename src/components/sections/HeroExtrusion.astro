---
import { hero } from '../../config/hero';
import { heroCut } from '../../config/home';
import barImage from '../../assets/hero/bar.png';
import cutterGif from '../../assets/hero/cutter.gif';
import logo from '../../assets/logo.png';
import ArrowRight from '../icons/ArrowRight.astro';
import Button from '../ui/Button.astro';

const titleLines = ['Engineering', 'Aluminium for', 'Modern Architecture.'];

const numeric = (value: string) => /^(\d+)(\D*)$/.exec(value);

const barCount = 3;
---

<section class="hero" data-hero aria-label="Alumex hero">
	<div class="hero__runway" data-hero-runway>
		<div class="hero__stage" data-hero-stage>
			<div class="hero__grid-bg" data-hero-bg aria-hidden="true"></div>
			<div class="hero__vignette" aria-hidden="true"></div>

			<div class="hero__inner">
				<div class="hero__copy">
					<div class="hero__brand" data-hero-brand>
						<div class="hero__logo" data-hero-logo>
							<img
								src={logo.src}
								width={logo.width}
								height={logo.height}
								alt="Alumex"
								class="hero__logo-img"
								draggable="false"
							/>
							<svg
								class="hero__slogan-ring"
								viewBox="0 0 200 200"
								role="img"
								aria-label="Towards a better future"
							>
								<title>Towards a better future</title>
								<defs>
									<!-- True circle just outside the emblem -->
									<path
										id="hero-slogan-arc"
										d="M 100 12 A 88 88 0 1 1 99.999 12"
										fill="none"
									/>
								</defs>
								<text class="hero__slogan-text">
									<textPath href="#hero-slogan-arc" startOffset="50%" text-anchor="middle">
										Towards a better future
									</textPath>
								</text>
							</svg>
						</div>
					</div>

					<!-- <h1 class="hero__title">
						{
							titleLines.map((line) => (
								<span class="hero__line">
									<span class="hero__line-inner" data-hero-line>
										{line}
									</span>
								</span>
							))
						}
					</h1> -->

					<div data-hero-trail>
						<p class="hero__description" data-hero-fade>{hero.description}</p>

						<div class="hero__actions" data-hero-fade>
							<Button href={hero.primaryCta.href} class="!rounded-full">
								{hero.primaryCta.label}
								<ArrowRight class="h-4 w-4" />
							</Button>
							<Button href={hero.secondaryCta.href} variant="secondary" class="!rounded-full">
								{hero.secondaryCta.label}
							</Button>
						</div>

						<ul class="hero__stats" data-hero-stats>
							{
								hero.stats.map((stat) => {
									const match = numeric(stat.value);
									return (
										<li>
											<span
												class="hero__stat-value"
												data-count={match?.[1]}
												data-count-suffix={match?.[2]}
											>
												{stat.value}
											</span>
											<span class="hero__stat-label">{stat.label}</span>
										</li>
									);
								})
							}
						</ul>
					</div>
				</div>

				<div class="hero__visual">
					<div class="hero3d" data-hero3d>
						<div class="hero3d__scene" data-hero-scene>
							<div class="hero3d__assembly" data-hero-assembly>
								{/* Bars sit behind the door plane, then come forward through the opening */}
								<div class="hero3d__lathe" data-hero-lathe>
									{
										Array.from({ length: barCount }, (_, i) => (
											<div class="hero3d__bar-row" data-hero-rod data-rod={i}>
												<div class="hero3d__bar-stock" data-hero-stock>
													<img
														src={barImage.src}
														width={barImage.width}
														height={barImage.height}
														alt=""
														class="hero3d__bar-img"
														draggable="false"
													/>
												</div>
												<div class="hero3d__bar-piece" data-hero-cut data-cut={i}>
													<img
														src={barImage.src}
														width={barImage.width}
														height={barImage.height}
														alt=""
														class="hero3d__bar-img"
														draggable="false"
													/>
												</div>
											</div>
										))
									}
								</div>

								{/* Door unit in front of bars so leaves occlude them until pushed back */}
								<div class="hero3d__portal" data-hero-portal>
									<div class="hero3d__frame" data-hero-frame>
										<div class="hero3d__bar hero3d__bar--top" data-hero-bar />
										<div class="hero3d__bar hero3d__bar--bottom" data-hero-bar />
										<div class="hero3d__bar hero3d__bar--left" data-hero-bar />
										<div class="hero3d__bar hero3d__bar--right" data-hero-bar />
									</div>

									<div class="hero3d__door hero3d__door--left" data-hero-door="left">
										<div class="hero3d__door-front">
											<div class="hero3d__glass" />
											<div class="hero3d__glass-sheen" />
										</div>
										<div class="hero3d__door-edge" />
										<div class="hero3d__door-back" />
									</div>

									<div class="hero3d__door hero3d__door--right" data-hero-door="right">
										<div class="hero3d__door-front">
											<div class="hero3d__glass" />
											<div class="hero3d__glass-sheen" />
										</div>
										<div class="hero3d__door-edge" />
										<div class="hero3d__door-back" />
									</div>

									<div class="hero3d__handle" data-hero-handle>
										<span class="hero3d__handle-cap" />
									</div>
								</div>

								<div class="hero3d__cutter" data-hero-cutter>
									<img
										src={cutterGif.src}
										width={cutterGif.width}
										height={cutterGif.height}
										alt=""
										class="hero3d__cutter-gif"
										draggable="false"
									/>
								</div>
							</div>
						</div>
						<div class="hero3d__floor" aria-hidden="true" />
					</div>

					<p class="hero__caption" data-hero-caption aria-hidden="true">Sealed system</p>

					<ul class="hero__layers" data-hero-layers>
						{
							heroCut.map((item, i) => (
								<li data-hero-chip data-cut={i}>
									<span class="hero__chip-swatch" data-cut={i} aria-hidden="true" />
									<span class="hero__chip-text">
										<span class="hero__chip-label">{item.label}</span>
										<span class="hero__chip-value">{item.value}</span>
										<span class="hero__chip-detail">{item.detail}</span>
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		overflow-x: clip;
		background: radial-gradient(ellipse at 70% 40%, #f4f8fc 0%, #eaf1f8 55%, #dde7f1 100%);
	}

	.hero__runway {
		height: 420vh;
	}

	.hero__stage {
		position: sticky;
		top: 0;
		display: flex;
		height: 100vh;
		align-items: center;
		overflow: hidden;
	}

	.hero__grid-bg {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(to right, rgb(31 78 140 / 6%) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(31 78 140 / 6%) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(ellipse at 68% 45%, black 8%, transparent 70%);
	}

	.hero__vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 50% 55%, transparent 50%, rgb(18 43 77 / 10%) 100%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: grid;
		width: 100%;
		max-width: 1440px;
		margin-inline: auto;
		gap: 3rem;
		padding: 4rem 1.5rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.hero__inner {
			grid-template-columns: 1.02fr 0.98fr;
			gap: 3.5rem;
			padding: 4rem 3rem;
		}
	}

	.hero__title {
		margin-bottom: 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5.4vw, 3.4rem);
		font-weight: 700;
		line-height: 1.07;
		letter-spacing: -0.02em;
		color: var(--heading);
	}

	.hero__line {
		display: block;
		overflow: hidden;
	}

	.hero__line-inner {
		display: block;
	}

	.hero__line:last-child .hero__line-inner {
		background: var(--brand-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__description {
		max-width: 30rem;
		margin-bottom: 1.75rem;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--muted);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero__stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		margin-top: 2.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-light);
	}

	@media (min-width: 640px) {
		.hero__stats {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.hero__stat-value {
		display: block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--primary);
	}

	.hero__stat-label {
		display: block;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--muted);
	}

	.hero__visual {
		display: none;
		min-width: 0;
	}

	@media (min-width: 1024px) {
		.hero__visual {
			display: block;
		}
	}

	.hero__brand {
		margin-bottom: 1.5rem;
	}

	.hero__logo {
		position: relative;
		width: 12rem;
		aspect-ratio: 1;
	}

	@media (min-width: 768px) {
		.hero__logo {
			width: 14rem;
		}
	}

	@media (min-width: 1024px) {
		.hero__logo {
			width: 16rem;
		}
	}

	.hero__logo-img {
		position: absolute;
		inset: 14%;
		z-index: 1;
		display: block;
		width: 72%;
		height: 72%;
		border-radius: 50%;
		object-fit: contain;
		filter: drop-shadow(0 14px 32px rgb(18 43 77 / 28%));
		user-select: none;
	}

	.hero__slogan-ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.hero__slogan-text {
		fill: var(--heading);
		font-family: var(--font-display);
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.hero__caption {
		margin-top: 0.75rem;
		text-align: center;
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--primary);
	}

	.hero__layers {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.625rem 1rem;
		margin-top: 1.25rem;
	}

	.hero__layers li {
		display: flex;
		gap: 0.625rem;
		min-width: 0;
		border-left: 2px solid var(--border);
		padding: 0.125rem 0 0.125rem 0.625rem;
		transition: border-color 0.3s, opacity 0.3s;
	}

	.hero__layers li[data-active] {
		border-left-color: var(--accent);
	}

	.hero__chip-swatch {
		margin-top: 0.25rem;
		height: 0.625rem;
		width: 0.625rem;
		flex-shrink: 0;
		border-radius: 2px;
	}

	li[data-cut='0'] .hero__chip-swatch {
		background: linear-gradient(135deg, #c8d0db, #8a96a6);
	}

	li[data-cut='1'] .hero__chip-swatch {
		background: linear-gradient(135deg, #2fa8e2, #1f4e8c);
	}

	li[data-cut='2'] .hero__chip-swatch {
		background: linear-gradient(135deg, #1f4e8c, #122b4d);
	}

	li[data-cut='3'] .hero__chip-swatch {
		background: linear-gradient(135deg, #eef2f6, #c4ccd5);
	}

	.hero__chip-text {
		min-width: 0;
	}

	.hero__chip-label {
		display: block;
		font-size: 0.5625rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.hero__chip-value {
		display: block;
		font-family: var(--font-display);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--heading);
	}

	.hero__chip-detail {
		display: block;
		font-size: 0.6875rem;
		color: var(--muted);
	}

	:global(html.js) .hero__logo,
	:global(html.js) .hero__slogan-ring,
	:global(html.js) .hero__line-inner,
	:global(html.js) .hero__description,
	:global(html.js) .hero__actions,
	:global(html.js) .hero__stats li,
	:global(html.js) .hero__caption,
	:global(html.js) .hero__layers li,
	:global(html.js) [data-hero-bar],
	:global(html.js) [data-hero-door],
	:global(html.js) [data-hero-handle],
	:global(html.js) [data-hero-rod],
	:global(html.js) [data-hero-cutter] {
		opacity: 0;
	}

	:global(html.js) .hero3d__bar-piece {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html.js) .hero__logo,
		:global(html.js) .hero__slogan-ring,
		:global(html.js) .hero__line-inner,
		:global(html.js) .hero__description,
		:global(html.js) .hero__actions,
		:global(html.js) .hero__stats li,
		:global(html.js) .hero__caption,
		:global(html.js) .hero__layers li,
		:global(html.js) [data-hero-bar],
		:global(html.js) [data-hero-door],
		:global(html.js) [data-hero-handle],
		:global(html.js) [data-hero-rod],
		:global(html.js) [data-hero-cutter] {
			opacity: 1;
		}

		:global(html.js) .hero3d__bar-piece {
			opacity: 1;
		}

		.hero__runway {
			height: auto;
		}

		.hero__stage {
			position: static;
			height: auto;
			min-height: 100vh;
		}
	}
</style>

<!-- 3D scene styles -->
<style>
	.hero3d {
		position: relative;
		perspective: 1800px;
		perspective-origin: 55% 42%;
		width: 100%;
		max-width: 34rem;
		margin-inline: auto;
		padding: 1.5rem 0.5rem 2.5rem;
		overflow: visible;
	}

	.hero3d__scene {
		position: relative;
		width: 22rem;
		height: 26rem;
		margin-inline: auto;
		transform-style: preserve-3d;
		overflow: visible;
		will-change: transform;
	}

	.hero3d__assembly {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		overflow: visible;
	}

	.hero3d__lathe {
		position: absolute;
		inset: 2.5rem -1rem 2.5rem -1rem;
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		z-index: 10;
		transform-style: preserve-3d;
		pointer-events: none;
	}

	.hero3d__bar-row {
		--bar-w: 600px;
		--bar-h: 2.2rem;
		--cut: 0.7;
		position: relative;
		width: var(--bar-w);
		height: var(--bar-h);
		margin-inline: auto;
		transform-style: preserve-3d;
		transform-origin: center center;
		/* filter: drop-shadow(0 8px 14px rgb(18 43 77 / 28%)); */
	}

	/* One full continuous bar — no permanent seam. Width shrinks only at cut. */
	.hero3d__bar-stock {
		position: relative;
		width: var(--bar-w);
		height: var(--bar-h);
		overflow: hidden;
	}

	.hero3d__bar-stock .hero3d__bar-img {
		display: block;
		width: var(--bar-w);
		height: var(--bar-h);
		max-width: none;
		pointer-events: none;
		user-select: none;
	}

	/* Right chunk — hidden until cut, then drops. Same image, offset to match seam. */
	.hero3d__bar-piece {
		position: absolute;
		top: 0;
		left: calc(var(--bar-w) * var(--cut));
		width: calc(var(--bar-w) * (1 - var(--cut)));
		height: var(--bar-h);
		overflow: hidden;
		opacity: 0;
		z-index: 40;
		pointer-events: none;
		transform-origin: left center;
		will-change: transform, opacity;
	}

	.hero3d__bar-piece .hero3d__bar-img {
		position: absolute;
		top: 0;
		left: calc(var(--bar-w) * var(--cut) * -1);
		display: block;
		width: var(--bar-w);
		height: var(--bar-h);
		max-width: none;
		pointer-events: none;
		user-select: none;
	}

	/* Big cutter centered on the cut seam */
	.hero3d__cutter {
		position: absolute;
		left: calc(-3rem + (600px * 0.7));
		top: -2rem;
		width: 14rem;
		height: 14rem;
		margin-left: -6.8rem;
		opacity: 0;
		z-index: 50;
		pointer-events: none;
		transform: translateZ(80px);
		transform-style: preserve-3d;
		will-change: transform, opacity;
	}

	.hero3d__cutter-gif {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: screen;
		/* filter: drop-shadow(0 8px 20px rgb(18 43 77 / 55%)); */
		transform: rotateY(-28deg) rotateX(6deg);
		pointer-events: none;
		user-select: none;
	}

	/* Whole door + frame — alone on stage until it clears, then bars enter */
	.hero3d__portal {
		position: absolute;
		inset: 0;
		z-index: 20;
		transform-style: preserve-3d;
		transform-origin: center center;
		will-change: transform, opacity;
	}

	/* Fixed aluminium frame — four extrusion bars */
	.hero3d__frame {
		position: absolute;
		inset: 0;
		z-index: 1;
		transform-style: preserve-3d;
	}

	.hero3d__bar {
		position: absolute;
		background:
			repeating-linear-gradient(90deg, #d6dde5 0px, #f1f4f7 1px, #b8c1cc 2px, #e4e9ef 3px),
			linear-gradient(135deg, #c8d0db 0%, #f1f4f7 30%, #aeb8c4 60%, #d9e0e8 100%);
		box-shadow:
			0 2px 4px rgb(18 43 77 / 25%),
			inset 0 1px 0 rgb(255 255 255 / 60%),
			inset 0 -1px 0 rgb(18 43 77 / 20%);
	}

	.hero3d__bar--top {
		top: 0;
		left: 0;
		right: 0;
		height: 0.75rem;
		border-radius: 2px 2px 0 0;
	}

	.hero3d__bar--bottom {
		bottom: 0;
		left: 0;
		right: 0;
		height: 0.75rem;
		border-radius: 0 0 2px 2px;
	}

	.hero3d__bar--left {
		top: 0.25rem;
		bottom: 0.25rem;
		left: 0;
		width: 0.75rem;
	}

	.hero3d__bar--right {
		top: 0.25rem;
		bottom: 0.25rem;
		right: 0;
		width: 0.75rem;
	}

	/* Door leaves — real 3D panels hinged on their outer edges */
	.hero3d__door {
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		width: calc(50% - 0.5rem);
		z-index: 2;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.hero3d__door--left {
		left: 0.5rem;
		transform-origin: left center;
	}

	.hero3d__door--right {
		right: 0.5rem;
		transform-origin: right center;
	}

	.hero3d__door-front,
	.hero3d__door-back,
	.hero3d__door-edge {
		position: absolute;
		inset: 0;
	}

	.hero3d__door-front {
		transform: translateZ(10px);
		background: linear-gradient(135deg, #cfd8e3 0%, #f7f9fb 28%, #aebac8 68%, #e6ecf2 100%);
		border: 2px solid #2a3f5f;
		border-radius: 2px;
		box-shadow:
			inset 0 0 0 4px rgb(255 255 255 / 45%),
			0 8px 18px rgb(18 43 77 / 35%);
		overflow: hidden;
		opacity: 1;
	}

	.hero3d__door-back {
		transform: translateZ(-10px) rotateY(180deg);
		background: linear-gradient(135deg, #9aa6b4 0%, #c4ccd5 100%);
		border: 2px solid #2a3f5f;
		border-radius: 2px;
		opacity: 1;
	}

	.hero3d__door-edge {
		transform: translateZ(0);
		background: linear-gradient(90deg, #aeb8c4, #d9e0e8, #aeb8c4);
	}

	.hero3d__door--left .hero3d__door-edge {
		width: 16px;
		transform: rotateY(-90deg) translateZ(8px);
		transform-origin: right center;
		right: -8px;
	}

	.hero3d__door--right .hero3d__door-edge {
		width: 16px;
		transform: rotateY(90deg) translateZ(8px);
		transform-origin: left center;
		left: -8px;
	}

	/* Glazing — keep solid enough to read as a real door, not a fade */
	.hero3d__glass {
		position: absolute;
		inset: 0.5rem;
		background: linear-gradient(
			150deg,
			rgb(180 198 214 / 85%) 0%,
			rgb(120 150 180 / 70%) 45%,
			rgb(70 100 140 / 75%) 100%
		);
		border: 1px solid rgb(31 78 140 / 45%);
		border-radius: 1px;
	}

	.hero3d__glass-sheen {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			105deg,
			transparent 38%,
			rgb(255 255 255 / 45%) 48%,
			rgb(255 255 255 / 60%) 52%,
			transparent 62%
		);
		opacity: 0.85;
		pointer-events: none;
	}

	/* Handle hardware at the meeting stile */
	.hero3d__handle {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 3;
		transform: translate(-50%, -50%) translateZ(10px);
		width: 0.5rem;
		height: 2.5rem;
		background: linear-gradient(135deg, #2a3f5f, #1f4e8c, #122b4d);
		border-radius: 4px;
		box-shadow: 0 2px 6px rgb(18 43 77 / 45%);
	}

	.hero3d__handle-cap {
		position: absolute;
		top: 0.25rem;
		left: 50%;
		transform: translateX(-50%);
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 6px var(--accent);
	}

	/* Contact shadow on the floor */
	.hero3d__floor {
		position: absolute;
		bottom: 0.75rem;
		left: 50%;
		transform: translateX(-50%);
		width: 18rem;
		height: 1.75rem;
		background: radial-gradient(ellipse at center, rgb(18 43 77 / 35%) 0%, transparent 70%);
		filter: blur(6px);
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const section = document.querySelector<HTMLElement>('[data-hero]');
	const runway = section?.querySelector<HTMLElement>('[data-hero-runway]');
	const stage = section?.querySelector<HTMLElement>('[data-hero-stage]');
	const scene = section?.querySelector<HTMLElement>('[data-hero-scene]');
	const caption = section?.querySelector<HTMLElement>('[data-hero-caption]');

	if (section && runway && stage && scene && caption && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const pick = <T extends Element>(selector: string) =>
			Array.from(section.querySelectorAll<T>(selector));

		const stats = pick<HTMLElement>('[data-hero-stats] li');
		const bars = pick<HTMLElement>('[data-hero-bar]');
		const doors = pick<HTMLElement>('[data-hero-door]');
		const rods = pick<HTMLElement>('[data-hero-rod]');
		const stocks = pick<HTMLElement>('[data-hero-stock]');
		const pieces = pick<HTMLElement>('[data-hero-cut]');
		const chips = pick<HTMLElement>('[data-hero-chip]');
		const assembly = section.querySelector<HTMLElement>('[data-hero-assembly]');
		const portal = section.querySelector<HTMLElement>('[data-hero-portal]');
		const cutter = section.querySelector<HTMLElement>('[data-hero-cutter]');

		const BAR_W = 600;
		const CUT_X = BAR_W * 0.7;

		/* Full bar until cut — no seam on the way in or when scrolling back */
		gsap.set(stocks, { width: BAR_W });
		gsap.set(pieces, { opacity: 0, y: 0, x: 0, rotate: 0 });
		gsap.set(rods, { opacity: 0, x: 120 });
		gsap.set(portal, { transformOrigin: '50% 50%', autoAlpha: 1 });
		gsap.set('[data-hero-door="left"]', { transformOrigin: 'left center' });
		gsap.set('[data-hero-door="right"]', { transformOrigin: 'right center' });

		const cutterYs =
			assembly && cutter
				? rods.map((row) => {
						const asmTop = assembly.offsetTop;
						const rowMid = row.offsetTop + row.offsetHeight / 2;
						return rowMid - asmTop - cutter.offsetHeight / 2;
					})
				: [8, 72, 136];

		/* Opening act, on load */
		const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });

		intro
			.fromTo(
				'[data-hero-logo]',
				{ opacity: 0, scale: 0.85 },
				{ opacity: 1, scale: 1, duration: 0.7 },
			)
			.fromTo(
				'.hero__slogan-ring',
				{ opacity: 0 },
				{ opacity: 1, duration: 0.55 },
				'-=0.35',
			)
			.fromTo(
				'[data-hero-line]',
				{ yPercent: 115, opacity: 0 },
				{ yPercent: 0, opacity: 1, duration: 1, stagger: 0.1 },
				'-=0.25',
			)
			.fromTo(
				'[data-hero-fade]',
				{ opacity: 0, y: 20 },
				{ opacity: 1, y: 0, duration: 0.7, stagger: 0.12 },
				'-=0.5',
			)
			.fromTo(stats, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.08 }, '-=0.4')
			.fromTo(bars, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.6, stagger: 0.08 }, 0.4)
			.fromTo(doors, { opacity: 0 }, { opacity: 1, duration: 0.7, stagger: 0.12 }, '-=0.3')
			.fromTo('[data-hero-handle]', { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.5 }, '-=0.3')
			.fromTo(caption, { opacity: 0 }, { opacity: 1, duration: 0.5 }, '-=0.3');

		/* Scrubbed act — duration 1, so positions read as progress */
		const reveal = gsap.timeline({
			defaults: { ease: 'none' },
			scrollTrigger: { trigger: runway, start: 'top top', end: 'bottom bottom', scrub: 0.7 },
		});

		/*
		  Sequence (no bar/door overlap — that always looks broken in CSS 3D):
		  1) Door opens + tilts back in 3D
		  2) Door clears the stage
		  3) Bars extrude into empty space
		  4) Cutter cuts
		*/
		reveal
			.to('[data-hero-cue]', { opacity: 0, duration: 0.05 }, 0)
			.fromTo(scene, { rotateX: 4, rotateY: 0 }, { rotateX: 9, rotateY: -5, duration: 1 }, 0)
			.fromTo(
				'[data-hero-door="left"]',
				{ rotateY: 0 },
				{ rotateY: -70, duration: 0.14, ease: 'power2.out' },
				0.03,
			)
			.fromTo(
				'[data-hero-door="right"]',
				{ rotateY: 0 },
				{ rotateY: 70, duration: 0.14, ease: 'power2.out' },
				0.03,
			)
			.to('[data-hero-handle]', { opacity: 0, duration: 0.04 }, 0.05)
			.fromTo(
				portal,
				{ rotateX: 0, rotateY: 0, z: 0, scale: 1 },
				{ rotateX: 14, rotateY: -8, z: -40, scale: 0.98, duration: 0.14, ease: 'power1.out' },
				0.12,
			)
			.to(
				'[data-hero-door="left"]',
				{ rotateY: -118, duration: 0.12, ease: 'power1.in' },
				0.2,
			)
			.to(
				'[data-hero-door="right"]',
				{ rotateY: 118, duration: 0.12, ease: 'power1.in' },
				0.2,
			)
			.to(
				portal,
				{ rotateX: 26, rotateY: -16, z: -180, scale: 0.86, duration: 0.14, ease: 'power1.in' },
				0.22,
			)
			.to(portal, { autoAlpha: 0, duration: 0.05, ease: 'none' }, 0.34)
			/* Bars only after door is gone — clean extrusion, no clipping through leaves */
			.fromTo(
				rods,
				{ opacity: 0, x: 160 },
				{ opacity: 1, x: -28, duration: 0.2, stagger: 0.05, ease: 'power2.out' },
				0.36,
			)
			.fromTo(
				cutter,
				{ opacity: 0, scale: 0.4, y: cutterYs[0], rotateY: -36 },
				{ opacity: 1, scale: 1, y: cutterYs[0], rotateY: -16, duration: 0.08, ease: 'power2.out' },
				0.56,
			);

		pieces.forEach((piece, index) => {
			const at = 0.62 + index * 0.09;
			const stock = stocks[index];

			if (index > 0 && cutter) {
				reveal.fromTo(
					cutter,
					{ y: cutterYs[index - 1] },
					{ y: cutterYs[index], duration: 0.05, ease: 'power1.inOut' },
					at - 0.03,
				);
			}

			if (stock) {
				reveal.fromTo(
					stock,
					{ width: BAR_W },
					{ width: CUT_X, duration: 0.02, ease: 'none' },
					at,
				);
			}

			reveal
				.fromTo(
					piece,
					{ opacity: 0, y: 0, x: 0, rotate: 0 },
					{ opacity: 1, y: 0, x: 0, rotate: 0, duration: 0.02, ease: 'none' },
					at,
				)
				.to(
					piece,
					{ y: 110, x: 16, rotate: 12, opacity: 0, duration: 0.16, ease: 'power2.in' },
					at + 0.02,
				);

			if (chips[index]) {
				reveal.fromTo(
					chips[index],
					{ opacity: 0.3, x: -6 },
					{ opacity: 1, x: 0, duration: 0.06 },
					at,
				);
			}
		});

		reveal
			.to(cutter, { opacity: 0, scale: 0.55, duration: 0.08 }, 0.9)
			.fromTo(chips[3], { opacity: 0.3, x: -6 }, { opacity: 1, x: 0, duration: 0.06 }, 0.9)
			.to('[data-hero-trail]', { opacity: 0.35, duration: 0.18 }, 0.92);

		/* Caption follows the scroll position */
		const scenes: [number, string][] = [
			[0.9, 'Cut to length'],
			[0.62, 'Slicing 6063-T5'],
			[0.56, 'Cutter engaged'],
			[0.36, 'Extrusion loaded'],
			[0.12, 'Leaves opening'],
			[0, 'Sealed system'],
		];

		ScrollTrigger.create({
			trigger: runway,
			start: 'top top',
			end: 'bottom bottom',
			onUpdate: (self) => {
				const next = scenes.find(([at]) => self.progress >= at)?.[1] ?? '';
				if (caption.textContent === next) return;
				gsap.to(caption, {
					opacity: 0,
					duration: 0.12,
					onComplete: () => {
						caption.textContent = next;
						gsap.to(caption, { opacity: 1, duration: 0.2 });
					},
				});
			},
		});

		/* Pointer-driven 3D camera tilt, layered on top of the scrubbed scene transform */
		const tiltY = gsap.quickTo(scene, 'rotateY', { duration: 0.8, ease: 'power3' });
		const tiltX = gsap.quickTo(scene, 'rotateX', { duration: 0.8, ease: 'power3' });

		stage.addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse') return;
			const x = event.clientX / window.innerWidth - 0.5;
			const y = event.clientY / window.innerHeight - 0.5;
			tiltY(x * 10);
			tiltX(6 + y * -10);
		});

		stage.addEventListener('pointerleave', () => {
			tiltY(-3);
			tiltX(4);
		});

		/* Hovering a legend entry highlights its rod */
		chips.forEach((chip, index) => {
			const rod = rods[index];
			if (!rod) return;

			chip.addEventListener('pointerenter', () => {
				chip.dataset.active = '';
				gsap.to(rod, { filter: 'brightness(1.25)', duration: 0.25 });
				gsap.to(
					rods.filter((other) => other !== rod),
					{ opacity: 0.45, duration: 0.25 },
				);
			});

			chip.addEventListener('pointerleave', () => {
				delete chip.dataset.active;
				gsap.to(rod, { filter: 'brightness(1)', duration: 0.25 });
				gsap.to(rods, { opacity: 1, duration: 0.25 });
			});
		});
	}
</script>
