---
import { site } from '../../config/site';
import Container from '../layout/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="map" class="border-t border-silver/40 bg-background-alt">
	<Container class="!px-0 md:py-16">
		<SectionHeader label="Visit Us" title="Find our facility" description={site.address} class="mb-10" />

		<div class="overflow-hidden rounded-xl border border-silver/40 bg-background shadow-sm">
			<iframe
				title={`${site.name} location map`}
				src={site.mapEmbedUrl}
				class="h-[560px] w-full border-0 md:h-[650px]"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			>
			</iframe>
		</div>
	</Container>
</section>
