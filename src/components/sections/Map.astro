---
import { site } from '../../config/site';
import Container from '../layout/Container.astro';
---

<section id="map" class="border-t border-silver/40 bg-background-alt">
	<Container class="!px-0 md:py-16">
		<div class="mb-10 text-center">
			<span class="mb-6 block text-sm font-medium tracking-[0.08em] text-primary uppercase">Visit Us</span>
			<h2 class="mb-4 font-display text-[1.7rem] sm:text-3xl lg:text-[3.1rem] leading-[1.1] font-bold tracking-tight text-heading">
				Find our facility
			</h2>
			<p class="text-lg leading-relaxed text-muted">{site.address}</p>
		</div>

		<div class="overflow-hidden rounded-xl border border-silver/40 bg-background shadow-sm">
			<iframe
				title={`${site.name} location map`}
				src={site.mapEmbedUrl}
				class="h-[560px] w-full border-0 md:h-[650px]"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			>
			</iframe>
		</div>
	</Container>
</section>
