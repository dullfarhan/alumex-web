---
import { expertise, specs, systems } from '../../config/home';
import ArrowRight from '../icons/ArrowRight.astro';
import GlobeIcon from '../icons/GlobeIcon.astro';
import HomeIcon from '../icons/HomeIcon.astro';
import LayersIcon from '../icons/LayersIcon.astro';
import Container from '../layout/Container.astro';

const icons = { home: HomeIcon, layers: LayersIcon, globe: GlobeIcon };
---

<section
	class="border-t border-silver/50 bg-background-alt py-32 bg-[linear-gradient(to_right,rgba(27,54,93,0.03)_1px,transparent_1px)] bg-size-[8.333%_100%]"
>
	<Container>
		<div class="mb-32 grid grid-cols-12 gap-8">
			<div class="col-span-12 md:col-span-1">
				<span class="text-xs font-medium tracking-[0.08em] text-primary uppercase">{expertise.number}</span>
			</div>
			<div class="col-span-12 md:col-span-5">
				<span class="mb-6 block text-xs font-medium tracking-[0.08em] text-muted uppercase">
					{expertise.label}
				</span>
				<h2 class="font-display text-4xl leading-[1.1] font-bold tracking-tight text-heading md:text-5xl">
					{expertise.title}
				</h2>
			</div>
			<div class="col-span-12 flex flex-col justify-end md:col-span-5 md:col-start-8">
				<p class="mb-6 text-lg leading-relaxed text-muted">{expertise.description}</p>
				<a href={expertise.link.href} class="group flex items-center gap-2 font-medium text-heading">
					<span>{expertise.link.label}</span>
					<ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
				</a>
			</div>
		</div>

		<div class="mb-32 grid grid-cols-12 gap-8">
			<div class="group relative col-span-12 h-[400px] overflow-hidden rounded-xl shadow-lg md:col-span-7 md:h-[600px]">
				<img
					src={systems.image}
					alt="Modern architecture facade"
					class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
				/>
				<div class="absolute bottom-0 left-0 w-full bg-linear-to-t from-primary-dark/80 to-transparent p-8 text-white">
					<span class="text-xs font-medium tracking-[0.08em] uppercase opacity-80">
						{systems.feature.label}
					</span>
					<h3 class="mt-1 font-display text-2xl font-bold">{systems.feature.title}</h3>
				</div>
			</div>

			<div class="col-span-12 flex flex-col justify-center space-y-10 md:col-span-4 md:col-start-9">
				{
					systems.items.map((item, i) => {
						const Icon = icons[item.icon];
						return (
							<>
								{i > 0 && <div class="h-px w-full bg-silver/60" />}
								<div class="flex items-start gap-4">
									<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-silver/40 text-primary">
										<Icon />
									</div>
									<div>
										<h4 class="mb-1 font-display text-lg font-bold text-heading">{item.title}</h4>
										<p class="text-sm leading-relaxed text-muted">{item.description}</p>
									</div>
								</div>
							</>
						);
					})
				}
			</div>
		</div>

		<div class="grid grid-cols-12 gap-8 border-t border-silver/60 pt-12">
			{
				specs.map((spec) => (
					<div class="col-span-12 md:col-span-4">
						<span class="text-xs font-medium tracking-[0.08em] text-muted uppercase">{spec.label}</span>
						<p class="mt-2 font-display text-2xl font-bold text-heading">{spec.value}</p>
					</div>
				))
			}
		</div>
	</Container>
</section>
