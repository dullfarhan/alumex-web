---
import { projectCategories, projectItems } from '../../../config/projects';
import Container from '../../layout/Container.astro';
import FilterChips from '../../ui/FilterChips.astro';
import SearchBar from '../../ui/SearchBar.astro';
---

<section class="border-b border-silver/40 bg-background">
	<Container class="!pt-16 !pb-8 md:!pt-20 md:!pb-10">
		<div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
			<SearchBar id="projects-search" label="Search projects" placeholder="Search projects…" />
			<FilterChips items={projectCategories} label="Filter by sector" />
		</div>
	</Container>
</section>
