---
import { Image } from 'astro:assets';
import { projectsGallery } from '../../../config/projects';
import ChevronRight from '../../icons/ChevronRight.astro';

const items = projectsGallery.items;
---

<section class="mx-auto w-full max-w-[1440px] px-3 sm:px-6" data-projects-gallery>
	<div class="rounded-b-3xl bg-[#e8f1fa] px-6 pt-28 pb-8 sm:rounded-b-4xl sm:px-12 sm:pt-32 md:pt-36 md:pb-10">
		<div class="w-full text-center">
			<h1 class="font-display text-[1.7rem] leading-[1.15] font-bold tracking-tight sm:text-3xl md:text-[3.1rem]">
				<span class="text-primary">{projectsGallery.accent}</span>{' '}
				<span class="text-heading">{projectsGallery.title}</span>
			</h1>
			<p class="mt-4 text-base leading-relaxed text-muted md:text-lg">{projectsGallery.description}</p>
		</div>
	</div>

	<div class="w-full px-1 pb-16 sm:px-0 md:pb-20">
		<div class="relative mt-6 sm:mt-8">
			<div class="relative overflow-hidden rounded-xl bg-primary-dark/5 sm:rounded-2xl">
				{
					items.map((item, index) => (
						<figure
							data-gallery-slide
							data-index={index}
							class:list={['relative', index === 0 ? '' : 'hidden']}
							hidden={index !== 0}
						>
							<Image
								src={item.image}
								alt={`${item.title} — ${item.category}, ${item.location}`}
								widths={[640, 960, 1280, 1600]}
								sizes="(min-width: 1024px) 72rem, 100vw"
								class="h-[min(56vh,24rem)] w-full object-cover sm:h-[min(60vh,30rem)] md:h-[min(64vh,38rem)]"
								loading={index === 0 ? 'eager' : 'lazy'}
							/>
							<figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-primary-dark/85 via-primary-dark/40 to-transparent px-5 py-5 sm:px-8 sm:py-7">
								<p class="text-xs font-medium tracking-[0.08em] text-white/75 uppercase">
									{item.category} · {item.location} · {item.year}
								</p>
								<a
									href={item.href}
									class="mt-1 inline-block font-display text-lg font-bold text-white transition-colors hover:text-accent sm:text-2xl"
								>
									{item.title}
								</a>
							</figcaption>
						</figure>
					))
				}

				<button type="button" class="gallery-zoom" data-gallery-zoom aria-label="View full image">
					<svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M15 3h6v6"></path>
						<path d="M9 21H3v-6"></path>
						<path d="M21 3l-7 7"></path>
						<path d="M3 21l7-7"></path>
					</svg>
				</button>
			</div>

			<div class="gallery-controls" aria-label="Gallery controls">
				<button type="button" data-gallery-prev aria-label="Previous project image">
					<ChevronRight class="h-6 w-6 rotate-180 text-white" />
				</button>
				<button type="button" data-gallery-next aria-label="Next project image">
					<ChevronRight class="h-6 w-6 text-white" />
				</button>
			</div>
		</div>

		<ul class="mt-4 grid grid-cols-3 gap-2 sm:mt-5 sm:grid-cols-4 sm:gap-3 md:grid-cols-6 md:gap-3" role="list">
			{
				items.map((item, index) => (
					<li>
						<button
							type="button"
							data-gallery-thumb
							data-index={index}
							aria-label={`Show ${item.title}`}
							aria-pressed={index === 0 ? 'true' : 'false'}
							class:list={[
								'group relative block w-full overflow-hidden rounded-md ring-2 transition-[box-shadow,opacity] sm:rounded-lg',
								index === 0 ? 'ring-primary opacity-100' : 'ring-transparent opacity-75 hover:opacity-100',
							]}
						>
							<Image
								src={item.image}
								alt=""
								widths={[160, 240, 320]}
								sizes="(min-width: 768px) 10rem, 30vw"
								class="aspect-[5/4] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-105"
								loading="lazy"
							/>
						</button>
					</li>
				))
			}
		</ul>
	</div>

	<div
		data-gallery-lightbox
		class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 p-4 sm:p-8"
		hidden
		role="dialog"
		aria-modal="true"
		aria-label="Full project image"
	>
		<div class="relative max-h-full max-w-full">
			<button
				type="button"
				data-gallery-lightbox-close
				class="gallery-lightbox-close"
				aria-label="Close full image"
			>
				<svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M18 6L6 18"></path>
					<path d="M6 6l12 12"></path>
				</svg>
			</button>
			<img data-gallery-lightbox-image alt="" class="max-h-[min(90vh,100%)] max-w-full object-contain" />
		</div>
	</div>
</section>

<style>
	.gallery-controls {
		position: absolute;
		z-index: 10;
		top: 50%;
		right: 0.75rem;
		left: 0.75rem;
		display: flex;
		justify-content: space-between;
		pointer-events: none;
		transform: translateY(-50%);
	}

	.gallery-controls button,
	.gallery-zoom,
	.gallery-lightbox-close {
		display: inline-flex;
		height: 1.8rem;
		width: 1.8rem;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: 9999px;
		background: linear-gradient(135deg, rgb(255 255 255 / 72%), rgb(255 255 255 / 38%));
		color: var(--color-primary);
		cursor: pointer;
		pointer-events: auto;
		-webkit-backdrop-filter: blur(14px) saturate(160%);
		backdrop-filter: blur(14px) saturate(160%);
		touch-action: manipulation;
		transition:
			background-color 200ms,
			box-shadow 200ms,
			color 200ms,
			transform 200ms;
	}

	.gallery-controls button:hover,
	.gallery-zoom:hover,
	.gallery-lightbox-close:hover {
		background: linear-gradient(135deg, rgb(255 255 255 / 84%), rgb(255 255 255 / 48%));
	}

	.gallery-controls button:active,
	.gallery-zoom:active,
	.gallery-lightbox-close:active {
		transform: scale(0.95);
	}

	.gallery-controls button:focus-visible,
	.gallery-zoom:focus-visible,
	.gallery-lightbox-close:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.gallery-zoom {
		position: absolute;
		z-index: 11;
		top: 0.75rem;
		right: 0.75rem;
		height: 2.25rem;
		width: 2.25rem;
		background: linear-gradient(135deg, rgb(18 43 77 / 72%), rgb(18 43 77 / 48%));
	}

	.gallery-zoom:hover {
		background: linear-gradient(135deg, rgb(18 43 77 / 84%), rgb(18 43 77 / 58%));
	}

	.gallery-lightbox-close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 2;
		height: 2.5rem;
		width: 2.5rem;
		background: linear-gradient(135deg, rgb(18 43 77 / 72%), rgb(18 43 77 / 48%));
	}

	.gallery-lightbox-close:hover {
		background: linear-gradient(135deg, rgb(18 43 77 / 84%), rgb(18 43 77 / 58%));
	}

	@media (min-width: 640px) {
		.gallery-controls {
			right: 1rem;
			left: 1rem;
		}

		.gallery-controls button {
			height: 2.2rem;
			width: 2.2rem;
		}

		.gallery-zoom {
			top: 1rem;
			right: 1rem;
			height: 2.5rem;
			width: 2.5rem;
		}
	}
</style>

<script>
	const root = document.querySelector('[data-projects-gallery]');
	if (root) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
		const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
		const prevBtn = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
		const nextBtn = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
		const zoomBtn = root.querySelector<HTMLButtonElement>('[data-gallery-zoom]');
		const lightbox = root.querySelector<HTMLElement>('[data-gallery-lightbox]');
		const lightboxImg = root.querySelector<HTMLImageElement>('[data-gallery-lightbox-image]');
		const lightboxClose = root.querySelector<HTMLButtonElement>('[data-gallery-lightbox-close]');
		const positionEl = root.querySelector<HTMLElement>('[data-gallery-position]');
		const total = slides.length;
		let current = 0;

		const goTo = (index: number) => {
			current = ((index % total) + total) % total;

			slides.forEach((slide, i) => {
				const active = i === current;
				slide.hidden = !active;
				slide.classList.toggle('hidden', !active);
			});

			thumbs.forEach((thumb, i) => {
				const active = i === current;
				thumb.setAttribute('aria-pressed', String(active));
				thumb.classList.toggle('ring-primary', active);
				thumb.classList.toggle('opacity-100', active);
				thumb.classList.toggle('ring-transparent', !active);
				thumb.classList.toggle('opacity-75', !active);
			});

			if (positionEl) positionEl.textContent = String(current + 1);
		};

		const openLightbox = () => {
			const slide = slides[current];
			const img = slide?.querySelector('img');
			if (!lightbox || !lightboxImg || !img) return;

			lightboxImg.src = img.currentSrc || img.src;
			lightboxImg.alt = img.alt;
			lightbox.hidden = false;
			lightbox.classList.remove('hidden');
			lightbox.classList.add('flex');
			document.body.style.overflow = 'hidden';
			lightboxClose?.focus();
		};

		const closeLightbox = () => {
			if (!lightbox) return;
			lightbox.hidden = true;
			lightbox.classList.add('hidden');
			lightbox.classList.remove('flex');
			document.body.style.overflow = '';
			zoomBtn?.focus();
		};

		prevBtn?.addEventListener('click', () => goTo(current - 1));
		nextBtn?.addEventListener('click', () => goTo(current + 1));
		thumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => goTo(Number(thumb.dataset.index)));
		});
		zoomBtn?.addEventListener('click', openLightbox);
		lightboxClose?.addEventListener('click', closeLightbox);
		lightbox?.addEventListener('click', (e) => {
			if (e.target === lightbox) closeLightbox();
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && lightbox && !lightbox.hidden) {
				e.preventDefault();
				closeLightbox();
				return;
			}
			if (!(e.target instanceof HTMLElement)) return;
			if (!root.contains(e.target)) return;
			if (lightbox && !lightbox.hidden) return;
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				goTo(current - 1);
			}
			if (e.key === 'ArrowRight') {
				e.preventDefault();
				goTo(current + 1);
			}
		});
	}
</script>
