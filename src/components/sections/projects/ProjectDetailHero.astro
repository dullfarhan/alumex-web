---
import { Image } from 'astro:assets';
import type { Project } from '../../../config/projects';
import Container from '../../layout/Container.astro';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<section class="bg-background">
	<Container class="!px-0 !pt-24 !pb-0 sm:!px-12 sm:!pt-24 md:!pt-28">
		<!-- Breadcrumbs stay outside the rounded hero panel -->
		<nav class="mb-6 px-6 text-sm text-muted sm:px-0" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2">
				<li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
				<li aria-hidden="true">/</li>
				<li><a href="/projects" class="transition-colors hover:text-primary">Projects</a></li>
				<li aria-hidden="true">/</li>
				<li class="text-heading">{project.title}</li>
			</ol>
		</nav>

		<div class="relative min-h-[min(44rem,calc(100vh-6rem))] overflow-hidden sm:rounded-4xl">
			<Image
				src={project.image}
				alt={project.title}
				widths={[800, 1200, 1800]}
				sizes="(max-width: 1440px) 100vw, 1440px"
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 bg-linear-to-t from-primary-dark via-primary-dark/45 to-primary-dark/20"></div>

			<div class="relative flex min-h-[min(44rem,calc(100vh-6rem))] items-end">
				<div class="w-full px-8 py-12 md:px-12 md:py-16 lg:py-20">
					<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-white/75 uppercase">
						{project.category} · {project.location} · {project.year}
					</span>
					<h1
						class="max-w-4xl font-display text-[2rem] leading-[1.05] font-bold tracking-tight text-white sm:text-4xl md:text-[3.25rem]"
					>
						{project.title}
					</h1>
					<p class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
						{project.shortDescription}
					</p>
				</div>
			</div>
		</div>
	</Container>
</section>
