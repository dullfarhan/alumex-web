---
import { Image } from 'astro:assets';
import type { Project } from '../../../config/projects';
import Container from '../../layout/Container.astro';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<section class="border-b border-silver/40 bg-background">
	<div class="border-b border-silver/40">
		<Container class="!py-4 md:!py-5">
			<nav class="text-sm text-muted" aria-label="Breadcrumb">
				<ol class="flex flex-wrap items-center gap-2">
					<li><a href="/projects" class="transition-colors hover:text-primary">Projects</a></li>
					<li aria-hidden="true">/</li>
					<li class="text-heading">{project.title}</li>
				</ol>
			</nav>
		</Container>
	</div>

	<div class="relative min-h-[60vh] overflow-hidden md:min-h-[70vh]">
		<Image
			src={project.image}
			alt={project.title}
			widths={[800, 1200, 1800]}
			sizes="100vw"
			class="absolute inset-0 h-full w-full object-cover"
			priority
		/>
		<div class="absolute inset-0 bg-linear-to-t from-primary-dark via-primary-dark/45 to-primary-dark/20"></div>

		<div class="relative flex min-h-[60vh] items-end md:min-h-[70vh]">
			<Container class="!pt-24 !pb-12 md:!pb-16">
				<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-white/75 uppercase">
					{project.category} · {project.location} · {project.year}
				</span>
				<h1 class="max-w-4xl font-display text-[2rem] leading-[1.05] font-bold tracking-tight text-white sm:text-4xl md:text-[3.25rem]">
					{project.title}
				</h1>
				<p class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">{project.shortDescription}</p>
			</Container>
		</div>
	</div>
</section>
