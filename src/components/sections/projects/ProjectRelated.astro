---
import { Image } from 'astro:assets';
import type { Project } from '../../../config/projects';
import ArrowRight from '../../icons/ArrowRight.astro';
import Container from '../../layout/Container.astro';
import Button from '../../ui/Button.astro';

interface Props {
	projects: Project[];
}

const { projects: related } = Astro.props;
---

{
	related.length > 0 && (
		<section class="border-b border-silver/40 bg-background-alt">
			<Container>
				<div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<h2 class="font-display text-2xl font-bold tracking-tight text-heading md:text-3xl">Related projects</h2>
					<Button href="/projects" variant="secondary">
						View all projects
						<ArrowRight class="h-3.5 w-3.5" />
					</Button>
				</div>

				<ul class="grid gap-6 sm:grid-cols-3">
					{related.map((project) => (
						<li>
							<a href={project.href} class="group block">
								<div class="overflow-hidden">
									<Image
										src={project.image}
										alt={project.title}
										widths={[320, 480, 640]}
										sizes="(max-width: 640px) 100vw, 33vw"
										class="aspect-[5/4] w-full object-cover transition-transform duration-700 group-hover:scale-105"
									/>
								</div>
								<span class="mt-3 block text-xs font-medium tracking-[0.08em] text-muted uppercase">
									{project.location} · {project.year}
								</span>
								<span class="mt-1 block font-display text-lg font-bold text-heading transition-colors group-hover:text-primary">
									{project.title}
								</span>
							</a>
						</li>
					))}
				</ul>
			</Container>
		</section>
	)
}
