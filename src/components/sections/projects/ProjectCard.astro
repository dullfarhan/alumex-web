---
import { Image } from 'astro:assets';
import type { Project } from '../../../config/projects';

interface Props {
	project: Project;
	featured?: boolean;
	class?: string;
}

const { project, featured = false, class: className } = Astro.props;
---

<a
	href={project.href}
	data-project-card
	data-title={project.title}
	data-category={project.category}
	data-location={project.location}
	data-description={`${project.shortDescription} ${project.description}`}
	data-featured={featured ? 'true' : 'false'}
	class:list={['group relative block overflow-hidden', featured && 'col-span-full', className]}
>
	<Image
		src={project.image}
		alt={project.title}
		widths={featured ? [800, 1200, 1600] : [400, 700, 1000]}
		sizes={featured ? '100vw' : '(max-width: 768px) 100vw, 50vw'}
		data-project-image
		class:list={[
			'w-full object-cover transition-transform duration-700 group-hover:scale-105',
			featured ? 'aspect-[2/1] md:aspect-[21/9]' : 'aspect-[4/5]',
		]}
	/>

	<div class="pointer-events-none absolute inset-0 bg-linear-to-t from-primary-dark/90 via-primary-dark/30 to-transparent"></div>

	<div class:list={['absolute inset-x-0 bottom-0', featured ? 'p-6 md:p-10' : 'p-5 md:p-6']} data-project-pad>
		<span class="mb-2 block text-xs font-medium tracking-[0.08em] text-white/75 uppercase">
			{project.category} · {project.location} · {project.year}
		</span>
		<h2
			data-project-title
			class:list={[
				'font-display font-bold text-white drop-shadow-sm',
				featured ? 'text-2xl sm:text-3xl md:text-4xl' : 'text-xl md:text-2xl',
			]}
		>
			{project.title}
		</h2>
		<p
			data-project-desc
			class:list={[
				'mt-3 max-w-2xl text-sm leading-relaxed text-white/85 md:text-base',
				!featured && 'hidden',
			]}
		>
			{project.shortDescription}
		</p>
	</div>
</a>
