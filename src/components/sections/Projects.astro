---
import { projects } from '../../config/projects';
import Container from '../layout/Container.astro';
---

<section id="projects" class="border-t border-silver/40 bg-background-alt py-24 md:py-32">
	<Container>
		<div class="mb-14 max-w-2xl">
			<span class="mb-4 block text-xs font-medium tracking-[0.08em] text-primary uppercase">{projects.label}</span>
			<h2 class="mb-4 font-display text-4xl leading-[1.1] font-bold tracking-tight text-heading md:text-5xl">
				{projects.title}
			</h2>
			<p class="text-lg leading-relaxed text-muted">{projects.description}</p>
		</div>

		<div class="grid gap-8 md:grid-cols-3">
			{
				projects.items.map((item) => (
					<article class="group overflow-hidden rounded-xl bg-background shadow-sm">
						<div class="overflow-hidden">
							<img
								src={item.image}
								alt={item.title}
								class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
						</div>
						<div class="p-6">
							<span class="mb-2 block text-xs font-medium tracking-[0.08em] text-muted uppercase">
								{item.category} · {item.location}
							</span>
							<h3 class="font-display text-xl font-bold text-heading">{item.title}</h3>
						</div>
					</article>
				))
			}
		</div>
	</Container>
</section>
