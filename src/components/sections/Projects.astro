---
import { projects } from '../../config/projects';
import ArrowRight from '../icons/ArrowRight.astro';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ProjectCard from './projects/ProjectCard.astro';

const featured = projects.items.slice(0, 3);
---

<section id="projects" class="border-t border-silver/40 bg-background-alt">
	<Container>
		<SectionHeader
			title={projects.title}
			description={projects.description}
			class="mb-14"
		/>

		<div
			class="grid grid-cols-1 gap-6 [&>*]:w-full sm:grid-cols-2 sm:gap-7 sm:[&>*:last-child:nth-child(odd)]:col-span-2 sm:[&>*:last-child:nth-child(odd)]:mx-auto sm:[&>*:last-child:nth-child(odd)]:max-w-[calc(50%-0.875rem)] lg:grid-cols-3 lg:gap-8 lg:[&>*:last-child:nth-child(odd)]:col-span-1 lg:[&>*:last-child:nth-child(odd)]:max-w-none"
		>
			{featured.map((item) => <ProjectCard project={item} class="rounded-2xl" />)}
		</div>

		<div class="mt-12 flex justify-center">
			<Button href="/projects" variant="secondary">
				View all projects
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>
		</div>
	</Container>
</section>
