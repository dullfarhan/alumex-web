---
import { contact } from '../../../config/contact';
import { site } from '../../../config/site';
import ArrowRight from '../../icons/ArrowRight.astro';
import Container from '../../layout/Container.astro';

const field =
	'w-full rounded-lg border border-border bg-background px-4 py-3 text-sm text-heading outline-none transition-colors placeholder:text-muted/70 focus:border-primary';
---

<section class="bg-background">
	<Container class="!pt-16 md:!pt-24">
		<div class="grid items-stretch gap-12 lg:grid-cols-12 lg:gap-14">
			<!-- RFQ form -->
			<div class="flex h-full flex-col lg:col-span-7">
				<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-primary uppercase">Send inquiry</span>
				<h2 class="mb-8 font-display text-2xl font-bold tracking-tight text-heading md:text-3xl">
					Project details
				</h2>

				<form action={contact.formAction} method="POST" class="flex flex-1 flex-col space-y-5">
					<input type="hidden" name="_subject" value={`New inquiry — ${site.name}`} />
					<input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

					<div class="grid gap-5 sm:grid-cols-2">
						<label class="block">
							<span class="mb-2 block text-sm font-medium text-heading">Full name</span>
							<input type="text" name="name" required autocomplete="name" class={field} placeholder="Your name" />
						</label>
						<label class="block">
							<span class="mb-2 block text-sm font-medium text-heading">Company</span>
							<input type="text" name="company" autocomplete="organization" class={field} placeholder="Company name" />
						</label>
					</div>

					<div class="grid gap-5 sm:grid-cols-2">
						<label class="block">
							<span class="mb-2 block text-sm font-medium text-heading">Email</span>
							<input type="email" name="email" required autocomplete="email" class={field} placeholder="you@company.com" />
						</label>
						<label class="block">
							<span class="mb-2 block text-sm font-medium text-heading">Phone</span>
							<input type="tel" name="phone" autocomplete="tel" class={field} placeholder="+92 ..." />
						</label>
					</div>

					<label class="block">
						<span class="mb-2 block text-sm font-medium text-heading">Project type</span>
						<select name="inquiryType" required class={field}>
							<option value="" disabled selected>Select a system or service</option>
							{contact.inquiryTypes.map((type) => <option value={type}>{type}</option>)}
						</select>
					</label>

					<label class="flex min-h-0 flex-1 flex-col">
						<span class="mb-2 block text-sm font-medium text-heading">Message</span>
						<textarea
							name="message"
							required
							rows="6"
							class={`${field} min-h-[9rem] flex-1 resize-none`}
							placeholder="Share sizes, finish preference, quantity, and timeline…"
						></textarea>
					</label>

					<button
						type="submit"
						class="inline-flex w-fit items-center gap-2 rounded-lg border border-primary-dark bg-primary-dark px-6 py-3 text-sm font-medium text-white transition-[background-color,color,border-color] duration-300 hover:bg-transparent hover:text-heading"
					>
						Send Inquiry
						<ArrowRight class="h-3.5 w-3.5" />
					</button>
				</form>
			</div>

			<!-- Sidebar -->
			<aside class="flex h-full flex-col lg:col-span-5">
				<div class="flex h-full flex-col border-t border-silver/40 pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
					<h2 class="mb-4 font-display text-xl font-bold tracking-tight text-heading">For a faster quote</h2>
					<p class="mb-6 text-sm leading-relaxed text-muted">
						Include these details when you can — it helps us respond with accurate systems and finish guidance.
					</p>
					<ul class="mb-8 space-y-3">
						{
							contact.rfqTips.map((tip) => (
								<li class="flex gap-3 text-sm leading-relaxed text-heading">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
									{tip}
								</li>
							))
						}
					</ul>

					<div class="space-y-3 border-t border-silver/40 pt-6 text-sm">
						<a
							href={`tel:${site.phone.replace(/\s/g, '')}`}
							class="flex items-center justify-between gap-3 text-heading transition-colors hover:text-primary"
						>
							<span class="text-muted">Call</span>
							<span class="font-medium">{site.phone}</span>
						</a>
						<a
							href={`mailto:${site.email}`}
							class="flex items-center justify-between gap-3 text-heading transition-colors hover:text-primary"
						>
							<span class="text-muted">Email</span>
							<span class="font-medium">{site.email}</span>
						</a>
						<p class="flex items-center justify-between gap-3 pt-1">
							<span class="text-muted">Hours</span>
							<span class="font-medium text-heading">{contact.hours}</span>
						</p>
					</div>

					<div class="mt-auto border-t border-silver/40 pt-8 lg:mt-10">
						<h2 class="mb-5 font-display text-xl font-bold tracking-tight text-heading">Common questions</h2>
						<div class="divide-y divide-silver/40 border-y border-silver/40">
							{
								contact.faq.map((item) => (
									<details class="group py-4">
										<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-sm font-semibold text-heading marker:content-none [&::-webkit-details-marker]:hidden">
											<span>{item.question}</span>
											<svg
												class="h-4 w-4 shrink-0 text-muted transition-transform duration-300 group-open:rotate-180"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												aria-hidden="true"
											>
												<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</summary>
										<p class="mt-3 pr-8 text-sm leading-relaxed text-muted">{item.answer}</p>
									</details>
								))
							}
						</div>
					</div>
				</div>
			</aside>
		</div>
	</Container>
</section>
