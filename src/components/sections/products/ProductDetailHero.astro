---
import { Image } from 'astro:assets';
import type { Product } from '../../../config/products';
import ArrowRight from '../../icons/ArrowRight.astro';
import Button from '../../ui/Button.astro';
import Container from '../../layout/Container.astro';

interface Props {
	product: Product;
}

const { product } = Astro.props;

const collage = [...new Map([product.image, ...product.gallery].map((img) => [img.src, img])).values()].slice(0, 4);
const [imgA, imgB, imgC, imgD] = collage;
---

<section class="border-b border-silver/40 bg-background">
	<Container>
		<nav class="mb-8 text-sm text-muted" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2">
				<li><a href="/products" class="transition-colors hover:text-primary">Products</a></li>
				<li aria-hidden="true">/</li>
				<li class="text-heading">{product.title}</li>
			</ol>
		</nav>

		<div class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-10">
			<div class="overflow-hidden rounded-xl bg-background-alt">
				<Image
					src={product.image}
					alt={product.title}
					widths={[640, 960, 1400]}
					sizes="(max-width: 1024px) 100vw, 50vw"
					class="h-full min-h-[22rem] w-full object-cover lg:min-h-[36rem]"
					priority
				/>
			</div>

			<div class="flex flex-col gap-8">
				<div>
					<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{product.category}</span>
					<h1 class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[2.75rem]">
						{product.title}
					</h1>
					<p class="mb-8 text-base leading-relaxed text-muted md:text-lg">{product.description}</p>
					<Button href="/contact">
						Request Quote
						<ArrowRight class="h-3.5 w-3.5" />
					</Button>
				</div>

				<div class="grid flex-1 gap-4 sm:grid-cols-2 sm:gap-5">
					<div class="flex flex-col justify-between border border-silver/50 bg-background-alt p-5 sm:p-6">
						<div>
							<h2 class="mb-4 font-display text-base font-bold text-heading">Specifications</h2>
							<ul class="space-y-0 border-t border-silver/50">
								{
									product.specs.map((spec) => (
										<li class="flex justify-between gap-3 border-b border-silver/50 py-2.5 text-sm">
											<span class="text-muted">{spec.label}</span>
											<span class="text-right font-medium text-heading">{spec.value}</span>
										</li>
									))
								}
							</ul>
						</div>
						{
							product.finishes.length > 0 && (
								<div class="mt-5 border-t border-silver/50 pt-4">
									<p class="mb-2 text-xs font-medium tracking-[0.08em] text-primary uppercase">Finishes</p>
									<ul class="flex flex-wrap gap-1.5">
										{product.finishes.slice(0, 4).map((finish) => (
											<li class="rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-medium text-heading">
												{finish}
											</li>
										))}
									</ul>
								</div>
							)
						}
					</div>

					{
						collage.length === 4 && (
							<div class="flex aspect-[5/6] gap-2 self-stretch sm:aspect-[4/5]">
								{/* Left: tall top + short bottom — shares sum to same column height as right */}
								<div class="flex min-w-0 flex-1 flex-col gap-2">
									<figure class="group min-h-0 flex-[1.35] overflow-hidden rounded-sm bg-background-alt">
										<Image
											src={imgA}
											alt={`${product.title} view 1`}
											widths={[200, 360]}
											sizes="(max-width: 1024px) 25vw, 12vw"
											class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									</figure>
									<figure class="group min-h-0 flex-[0.65] overflow-hidden rounded-sm bg-background-alt">
										<Image
											src={imgB}
											alt={`${product.title} view 2`}
											widths={[200, 360]}
											sizes="(max-width: 1024px) 25vw, 12vw"
											class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									</figure>
								</div>
								{/* Right: short top + tall bottom — different split so middle seam zigzags */}
								<div class="flex min-w-0 flex-1 flex-col gap-2">
									<figure class="group min-h-0 flex-[0.8] overflow-hidden rounded-sm bg-background-alt">
										<Image
											src={imgC}
											alt={`${product.title} view 3`}
											widths={[200, 360]}
											sizes="(max-width: 1024px) 25vw, 12vw"
											class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									</figure>
									<figure class="group min-h-0 flex-[1.2] overflow-hidden rounded-sm bg-background-alt">
										<Image
											src={imgD}
											alt={`${product.title} view 4`}
											widths={[200, 360]}
											sizes="(max-width: 1024px) 25vw, 12vw"
											class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									</figure>
								</div>
							</div>
						)
					}
				</div>
			</div>
		</div>
	</Container>
</section>
