---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProductHighlightIcon } from '../../../config/products';
import ArrowRight from '../../icons/ArrowRight.astro';
import HighlightIcon from '../../icons/HighlightIcon.astro';
import Button from '../../ui/Button.astro';
import Container from '../../layout/Container.astro';

interface Props {
	product: {
		title: string;
		category: string;
		description: string;
		image: ImageMetadata;
		highlights: { label: string; icon: ProductHighlightIcon }[];
		href: string;
	};
	/** Override breadcrumb parent (default: Products) */
	collectionHref?: string;
	collectionLabel?: string;
}

const { product, collectionHref = '/products', collectionLabel = 'Products' } = Astro.props;
---

<section class="bg-background">
	<Container class="!px-0 !pt-24 !pb-8 sm:!px-12 sm:!pt-24 md:!pt-28 md:!pb-12">
		<nav class="mb-6 px-6 text-sm text-muted sm:px-0" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2">
				<li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
				<li aria-hidden="true">/</li>
				<li><a href={collectionHref} class="transition-colors hover:text-primary">{collectionLabel}</a></li>
				<li aria-hidden="true">/</li>
				<li>
					<a
						href={`${collectionHref}?category=${encodeURIComponent(product.category)}`}
						class="transition-colors hover:text-primary"
					>
						{product.category}
					</a>
				</li>
				<li aria-hidden="true">/</li>
				<li class="text-heading">{product.title}</li>
			</ol>
		</nav>

		<div class="relative overflow-hidden sm:rounded-4xl">
			<Image
				src={product.image}
				alt={product.title}
				widths={[800, 1200, 1600, 2000]}
				sizes="(max-width: 1440px) 100vw, 1440px"
				quality={90}
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 bg-linear-to-t from-primary-dark via-primary-dark/55 to-primary-dark/25"></div>

			<div class="relative flex items-end">
				<div class="mt-auto w-full px-8 pt-24 pb-10 md:px-12 md:pt-32 md:pb-12 lg:pb-14">
					<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-white/80 uppercase">
						{product.category}
					</span>
					<h1
						class="max-w-4xl font-display text-[2rem] leading-[1.05] font-bold tracking-tight text-white sm:text-4xl md:text-[3.25rem]"
					>
						{product.title}
					</h1>
					<p class="mt-4 max-w-2xl text-base leading-relaxed text-white/90 md:text-lg">
						{product.description}
					</p>

				

				</div>
			</div>
		</div>
	</Container>
</section>
