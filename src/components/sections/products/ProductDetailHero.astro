---
import { Image } from 'astro:assets';
import type { Product } from '../../../config/products';
import ArrowRight from '../../icons/ArrowRight.astro';
import DownloadIcon from '../../icons/DownloadIcon.astro';
import HighlightIcon from '../../icons/HighlightIcon.astro';
import Button from '../../ui/Button.astro';
import Container from '../../layout/Container.astro';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<section class="relative overflow-hidden border-b border-silver/40 bg-background">
	<!-- Diagonal hero image: full behind content on mobile, clipped on desktop -->
	<div
		class="relative h-64 overflow-hidden sm:h-80 md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[56%] md:[clip-path:polygon(14%_0,100%_0,100%_100%,0_100%)]"
		aria-hidden="true"
	>
		<Image
			src={product.image}
			alt=""
			widths={[640, 960, 1400]}
			sizes="(max-width: 767px) 100vw, 56vw"
			class="absolute inset-0 h-full w-full object-cover"
			priority
		/>
		<div class="absolute inset-0 bg-primary-dark/20 md:bg-transparent"></div>
	</div>

	<Container class="relative z-10">
		<nav class="mb-8 text-sm text-muted" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2">
				<li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
				<li aria-hidden="true">/</li>
				<li><a href="/products" class="transition-colors hover:text-primary">Products</a></li>
				<li aria-hidden="true">/</li>
				<li><a href="/products" class="transition-colors hover:text-primary">{product.category}</a></li>
				<li aria-hidden="true">/</li>
				<li class="text-heading">{product.title}</li>
			</ol>
		</nav>

		<div class="max-w-xl pb-4 md:min-h-[28rem] md:pb-10 lg:min-h-[32rem]">
			<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{product.category}</span>
			<h1 class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[2.75rem]">
				{product.title}
			</h1>
			<span class="mb-5 block h-0.5 w-12 bg-primary" aria-hidden="true"></span>
			<p class="mb-8 text-base leading-relaxed text-muted md:text-lg">{product.description}</p>

			<div class="flex flex-wrap items-center gap-4">
				<Button href="/contact">
					Request Quote
					<ArrowRight class="h-3.5 w-3.5" />
				</Button>
			</div>
		</div>

		<ul class="grid grid-cols-2 gap-6 border-t border-silver/50 py-8 sm:grid-cols-4 md:max-w-xl md:gap-5 lg:gap-8">
			{
				product.highlights.map((item) => (
					<li class="flex flex-col items-start gap-2">
						<span class="flex h-10 w-10 items-center justify-center rounded-full border border-silver/60 bg-background-alt text-primary">
							<HighlightIcon name={item.icon} class="h-5 w-5" />
						</span>
						<span class="text-xs leading-snug font-medium text-heading sm:text-sm">{item.label}</span>
					</li>
				))
			}
		</ul>
	</Container>
</section>
