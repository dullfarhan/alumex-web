---
import { productItems } from '../../../config/products';
import Container from '../../layout/Container.astro';
import MobileCarousel from '../../ui/MobileCarousel.astro';
import ProductCard from './ProductCard.astro';
---

<section class="border-b border-silver/40 bg-background">
	<Container>
		<MobileCarousel
			label="Product catalog"
			controlsPosition="bottom-right"
			trackId="products-grid"
			desktopClass="min-w-0 sm:grid sm:grid-cols-1 sm:gap-6 lg:grid-cols-2 lg:gap-7 xl:grid-cols-3 xl:gap-8"
		>
			{productItems.map((product, index) => <ProductCard product={product} index={index} />)}
		</MobileCarousel>
		<p id="products-empty" class="hidden py-16 text-center text-muted" hidden>
			No systems match your search. Try another keyword or category.
		</p>
	</Container>
</section>
