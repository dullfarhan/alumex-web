---
import { productItems } from '../../../config/products';
import Container from '../../layout/Container.astro';
import MobileCarousel from '../../ui/MobileCarousel.astro';
import ProductCard from './ProductCard.astro';
---

<section class="border-b border-silver/40 bg-background" data-products-catalog>
	<Container>
		{/* Mobile carousel only */}
		<div class="sm:hidden">
			<MobileCarousel label="Product catalog" trackId="products-grid-mobile" desktopClass="w-full">
				{productItems.map((product, index) => <ProductCard product={product} index={index} />)}
			</MobileCarousel>
		</div>

		{/* Desktop / tablet grid — separate from carousel */}
		<div
			id="products-grid"
			class="hidden sm:flex flex-wrap justify-center gap-6"
		>
			{productItems.map((product, index) => <ProductCard product={product} index={index} />)}
		</div>

		<p id="products-empty" class="hidden py-16 text-center text-muted" hidden>
			No systems match your search. Try another keyword or category.
		</p>
	</Container>
</section>
