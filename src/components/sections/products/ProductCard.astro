---
import { Image } from 'astro:assets';
import type { Product } from '../../../config/products';
import ArrowRight from '../../icons/ArrowRight.astro';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<a
	href={product.href}
	data-product-card
	data-title={product.title}
	data-category={product.category}
	data-description={`${product.shortDescription} ${product.description}`}
	class="group flex flex-col overflow-hidden rounded-2xl border border-silver/50 bg-background transition-shadow duration-300 hover:shadow-[0_12px_36px_rgba(18,43,77,0.1)]"
>
	<div class="overflow-hidden">
		<Image
			src={product.image}
			alt={product.title}
			widths={[400, 600, 800]}
			sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
			class="aspect-[5/3] w-full object-cover transition-transform duration-700 group-hover:scale-105"
		/>
	</div>
	<div class="flex flex-1 flex-col px-5 py-6">
		<span class="mb-2 text-xs font-medium tracking-[0.08em] text-primary uppercase">{product.category}</span>
		<h2 class="mb-2 font-display text-xl font-bold text-heading">{product.title}</h2>
		<p class="mb-5 flex-1 text-sm leading-relaxed text-muted">{product.shortDescription}</p>
		<span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
			View details
			<ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
		</span>
	</div>
</a>
