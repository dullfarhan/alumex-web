---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowRight from '../../icons/ArrowRight.astro';
import Button from '../../ui/Button.astro';

interface Props {
	product: {
		title: string;
		category: string;
		shortDescription: string;
		description: string;
		image: ImageMetadata;
		href: string;
	};
	index: number;
}

const { product, index } = Astro.props;
const listingNumber = String(index + 1).padStart(2, '0');
---

<article
	data-product-card
	data-listing-number={listingNumber}
	data-title={product.title}
	data-category={product.category}
	data-description={`${product.shortDescription} ${product.description}`}
	class="group flex w-full max-w-[22rem] flex-col overflow-hidden rounded-2xl border border-silver/60 bg-white shadow-[0_8px_28px_rgba(18,43,77,0.08)] transition-shadow duration-300 hover:shadow-[0_14px_36px_rgba(18,43,77,0.14)]"
>
	<div
		class="relative h-[14rem] shrink-0 overflow-hidden bg-gradient-to-br from-[#c5d8ee] via-[#d7e6f5] to-[#b9d4ec]"
		aria-hidden="true"
	>
		<Image
			src={product.image}
			alt=""
			widths={[400, 600, 800]}
			sizes="(max-width: 640px) 100vw, 22rem"
			class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
		/>
	</div>

	<div class="flex min-h-0 flex-1 flex-col px-5 pt-5 pb-5 rounded-t-2xl text-left">
		<div class="flex items-center justify-between">
			<h2 class="font-display text-xl leading-snug font-bold tracking-tight text-heading">
				{product.title}
			</h2>
	
			<span
				class="mt-2.5 inline-flex w-fit rounded-md border border-silver/80 px-2 py-0.5 text-[0.65rem] font-semibold tracking-[0.08em] text-muted uppercase"
			>
				{product.category}
			</span>
		</div>
		

		<p class="lex-1 text-sm leading-relaxed text-muted">
			{product.shortDescription}
		</p>

		<Button href={product.href} class="mt-4 w-full justify-center !rounded-full">
			Explore Details
			<ArrowRight class="h-3.5 w-3.5" />
		</Button>
	</div>
</article>
