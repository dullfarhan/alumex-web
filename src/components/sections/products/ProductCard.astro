---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowRight from '../../icons/ArrowRight.astro';
import Button from '../../ui/Button.astro';

interface Props {
	product: {
		title: string;
		category: string;
		shortDescription: string;
		description: string;
		image: ImageMetadata;
		href?: string;
	};
	index: number;
}

const { product, index } = Astro.props;
const listingNumber = String(index + 1).padStart(2, '0');
---

<article
	data-product-card
	data-listing-number={listingNumber}
	data-title={product.title}
	data-category={product.category}
	data-description={`${product.shortDescription} ${product.description}`}
	class="group flex w-full max-w-[22.5rem] flex-col rounded-[1.5rem] shadow-none transition-shadow duration-300 sm:shadow-[-10px_0_24px_rgba(18,43,77,0.1),10px_0_24px_rgba(18,43,77,0.1),0_6px_16px_rgba(18,43,77,0.06)] sm:hover:shadow-[-12px_0_28px_rgba(18,43,77,0.12),12px_0_28px_rgba(18,43,77,0.12),0_8px_18px_rgba(18,43,77,0.08)]"
>
	<div
		class="relative h-[16rem] shrink-0 overflow-hidden rounded-t-[1.5rem] bg-gradient-to-br from-[#c5d8ee] via-[#d7e6f5] to-[#b9d4ec]"
		aria-hidden="true"
	>
		<Image
			src={product.image}
			alt=""
			widths={[400, 600, 800]}
			sizes="(max-width: 640px) 100vw, 22rem"
			class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
		/>
	</div>

	<div
		class="relative z-10 -mt-7 flex flex-1 flex-col rounded-[1.5rem] border border-silver/40 bg-white px-5 pt-5 pb-5 text-left shadow-[0_-6px_14px_rgba(18,43,77,0.06)]"
	>
		<div class="flex items-start justify-between gap-3">
			<h2 class="font-display text-xl leading-snug font-bold tracking-tight text-heading">
				{product.title}
			</h2>

			<span
				class="mt-1 inline-flex shrink-0 rounded-md border border-silver/80 px-2 py-0.5 text-[0.65rem] font-semibold tracking-[0.08em] text-muted uppercase"
			>
				{product.category}
			</span>
		</div>

		<p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
			{product.shortDescription}
		</p>

		{
			product.href && (
				<Button href={product.href} class="mt-4 w-full justify-center !rounded-full">
					Explore Details
					<ArrowRight class="h-3.5 w-3.5" />
				</Button>
			)
		}
	</div>
</article>
