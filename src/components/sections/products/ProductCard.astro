---
import { Image } from 'astro:assets';
import type { Product } from '../../../config/products';
import ArrowRight from '../../icons/ArrowRight.astro';

interface Props {
	product: Product;
	index: number;
}

const { product, index } = Astro.props;
const listingNumber = String(index + 1).padStart(2, '0');
---

<a
	href={product.href}
	data-product-card
	data-listing-number={listingNumber}
	data-title={product.title}
	data-category={product.category}
	data-description={`${product.shortDescription} ${product.description}`}
	class="group relative flex h-full min-h-0 w-full min-w-0 aspect-[5/4] flex-col overflow-hidden rounded-2xl border border-silver/50 bg-white shadow-[0_8px_30px_rgba(18,43,77,0.08)] transition-shadow duration-300 hover:shadow-[0_12px_36px_rgba(18,43,77,0.12)] sm:aspect-[4/3]"
>
	{/* Image stays right of the diagonal so it never covers copy */}
	<div
		class="absolute inset-0 [clip-path:polygon(62%_0,100%_0,100%_100%,45%_100%)]"
		aria-hidden="true"
	>
		<Image
			src={product.image}
			alt=""
			widths={[400, 600, 800]}
			sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
			class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
		/>
	</div>

	{/* Keep copy inside the white wedge (left of the 45–62% diagonal) */}
	<div class="relative z-10 flex h-full w-[55%] min-w-0 flex-col justify-between p-4 sm:p-5 xl:w-[45%]">
		<div class="min-w-0">
			<div class="relative mb-2 inline-block pl-2 pt-1.5">
				<span
					class="absolute top-0 left-0 h-3 w-3 border-t-2 border-l-2 border-primary"
					aria-hidden="true"
				></span>
				<span
					data-listing-label
					class="font-display text-xl font-medium tracking-tight text-primary sm:text-2xl"
					>{listingNumber}</span
				>
			</div>

			<h2 class="mb-1.5 font-display text-base leading-snug font-bold break-words text-heading sm:text-lg">
				{product.title}
			</h2>
			<span class="mb-1.5 block h-0.5 w-8 bg-primary" aria-hidden="true"></span>
			<p class="text-sm leading-snug break-words text-muted">
				{product.shortDescription}
			</p>
		</div>

		<span
			class="mt-3 inline-flex h-[2.2rem] w-[2.2rem] shrink-0 items-center justify-center rounded-full border border-silver bg-white text-primary shadow-[0_4px_14px_rgba(18,43,77,0.1)] transition-transform duration-300 group-hover:translate-x-0.5"
			aria-hidden="true"
		>
			<ArrowRight class="h-5 w-5" />
		</span>
	</div>
</a>
