---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../../layout/Container.astro';

interface Props {
	label?: string;
	title: string;
	description?: string;
	images: ImageMetadata[];
	class?: string;
}

const {
	label = 'Finish samples',
	title,
	description = 'Browse the full set of available samples for this finish.',
	images,
	class: className,
} = Astro.props;

const gallery = [...new Map(images.map((img) => [img.src, img])).values()];
---

<section class:list={['border-b border-silver/40 bg-background', className]}>
	<Container class="!pt-10 !pb-12 md:!pt-12 md:!pb-16">
		<div class="mb-8 md:mb-10">
			<span class="mb-3 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{label}</span>
			<h2 class="font-display text-[1.5rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-2xl md:text-3xl">
				{title}
			</h2>
			<p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{description}</p>
		</div>

		{
			gallery.length > 0 ? (
				<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3" role="list">
					{gallery.map((image, index) => (
						<li>
							<figure class="overflow-hidden rounded-xl bg-background-alt shadow-[0_8px_24px_rgba(18,43,77,0.1)]">
								<Image
									src={image}
									alt={`${title} sample ${index + 1}`}
									widths={[480, 720, 1100]}
									sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
									quality={90}
									class="aspect-[5/2] w-full object-cover"
									loading={index < 3 ? 'eager' : 'lazy'}
								/>
							</figure>
						</li>
					))}
				</ul>
			) : (
				<p class="text-sm text-muted">Samples coming soon.</p>
			)
		}
	</Container>
</section>
