---
import { Image } from 'astro:assets';
import { finishDescriptions, finishes } from '../../../config/finishes';
import type { Product } from '../../../config/products';
import Container from '../../layout/Container.astro';

interface Props {
	product: Product;
}

const { product } = Astro.props;

const cards = product.finishes
	.map((name) => {
		const match = finishes.items.find((item) => item.title === name);
		if (!match) return null;
		return {
			title: name,
			href: match.href,
			image: match.image,
			description: finishDescriptions[name] ?? 'Architectural surface finish for lasting performance.',
		};
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);
---

{
	cards.length > 0 && (
		<section class="border-b border-silver/40 bg-background">
			<Container>
				<div class="rounded-2xl bg-background-alt px-6 py-10 sm:px-8 md:px-10 md:py-12">
					<h2 class="mb-8 font-display text-xl font-bold tracking-tight text-heading md:text-2xl">Available Finishes</h2>
					<ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{cards.map((finish) => (
							<li>
								<a
									href={finish.href}
									class="flex h-full gap-4 rounded-xl border border-silver/40 bg-background p-4 transition-colors hover:border-primary/40"
								>
									<div class="h-14 w-14 shrink-0 overflow-hidden rounded-lg">
										<Image
											src={finish.image}
											alt=""
											widths={[80, 112]}
											sizes="56px"
											class="h-full w-full object-cover"
										/>
									</div>
									<div class="min-w-0">
										<h3 class="mb-1 font-display text-sm font-bold text-heading">{finish.title}</h3>
										<p class="text-xs leading-relaxed text-muted">{finish.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</div>
			</Container>
		</section>
	)
}
