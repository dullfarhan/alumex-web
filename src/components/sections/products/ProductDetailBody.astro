---
import type { Product } from '../../../config/products';
import Container from '../../layout/Container.astro';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<section class="border-b border-silver/40 bg-background">
	<Container>
		<div class="grid gap-12 md:grid-cols-2 md:gap-16">
			<div>
				<h2 class="mb-5 font-display text-xl font-bold tracking-tight text-heading md:text-2xl">Key features</h2>
				<ul class="space-y-3">
					{
						product.features.map((feature) => (
							<li class="flex gap-3 border-t border-silver/60 pt-3 text-sm leading-relaxed text-heading md:text-base">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
								{feature}
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="mb-5 font-display text-xl font-bold tracking-tight text-heading md:text-2xl">Applications</h2>
				<ul class="mb-8 flex flex-wrap gap-2">
					{
						product.applications.map((item) => (
							<li class="rounded-full border border-silver/60 px-3.5 py-1.5 text-sm text-heading">{item}</li>
						))
					}
				</ul>

				{
					product.finishes.length > 0 && (
						<>
							<h2 class="mb-4 font-display text-xl font-bold tracking-tight text-heading md:text-2xl">Finishes</h2>
							<ul class="flex flex-wrap gap-2">
								{product.finishes.map((finish) => (
									<li>
										<a
											href="/#finishes"
											class="inline-block rounded-full border border-border bg-background-alt px-3 py-1.5 text-xs font-medium text-heading transition-colors hover:border-primary hover:text-primary"
										>
											{finish}
										</a>
									</li>
								))}
							</ul>
						</>
					)
				}
			</div>
		</div>
	</Container>
</section>
