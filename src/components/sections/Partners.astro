---
import { Image } from 'astro:assets';
import { partners } from '../../config/partners';
import Container from '../layout/Container.astro';
---

<section class="border-y border-silver/40 bg-background">
	<Container>
		<div class="mb-10 text-center md:mb-12">
			<span class="mb-6 block text-sm font-medium tracking-[0.08em] text-primary uppercase">
				{partners.label}
			</span>
			<h2 class="font-display text-[1.7rem] sm:text-3xl font-bold text-heading md:text-[3.1rem]">{partners.title}</h2>
		</div>

		<ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-6 md:gap-8">
			{
				partners.items.map((partner) => (
					<li class="flex items-center justify-center">
						<Image
							src={partner.logo}
							alt={partner.name}
							widths={[160, 240, 320]}
							sizes="(max-width: 768px) 40vw, 12vw"
							class="h-8 w-auto max-w-[120px] object-contain opacity-60 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0 md:h-10"
						/>
					</li>
				))
			}
		</ul>
	</Container>
</section>
