---
import { Image } from 'astro:assets';
import { partners } from '../../config/partners';
import Container from '../layout/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section class="border-y border-silver/40 bg-background">
	<Container>
		<SectionHeader title={partners.title} class="mb-10 md:mb-12" />

		<div class="partners-viewport" aria-label="Industry partners">
			<div class="partners-track">
				{
					[false, true].map((duplicate) => (
						<ul class="partners-group" aria-hidden={duplicate ? 'true' : undefined}>
							{partners.items.map((partner) => (
								<li>
									<Image
										src={partner.logo}
										alt={partner.name}
										widths={[160, 240, 320]}
										sizes="(max-width: 768px) 40vw, 12vw"
										class="h-10 w-auto max-w-[140px] object-contain md:h-14"
									/>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</Container>
</section>

<style>
	.partners-viewport {
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
	}

	.partners-track {
		display: flex;
		width: max-content;
		animation: partners-scroll 24s linear infinite;
		will-change: transform;
	}

	.partners-group {
		display: flex;
		flex-shrink: 0;
		gap: 4rem;
		padding-right: 4rem;
	}

	.partners-group li {
		display: flex;
		width: auto;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
	}

	@keyframes partners-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.partners-viewport {
			overflow-x: auto;
			mask-image: none;
		}

		.partners-track {
			animation: none;
		}

		.partners-group[aria-hidden='true'] {
			display: none;
		}
	}
</style>
