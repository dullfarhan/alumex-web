---
import { hero } from '../../config/hero';
import ArrowRight from '../icons/ArrowRight.astro';
import Button from '../ui/Button.astro';
---

<section class="relative min-h-[calc(100vh-5rem)] overflow-hidden bg-background">
	<!-- Dot grid texture (fades toward the image) -->
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(20,36,60,0.08)_1px,transparent_1px)] bg-size-[16px_16px] [mask-image:radial-gradient(ellipse_at_bottom_left,black_20%,transparent_65%)]"
		aria-hidden="true"
	>
	</div>

	<!-- Desktop image: right side with diagonal cut like the reference -->
	<div
		class="absolute inset-y-0 right-0 hidden w-full md:block"
		style="clip-path: polygon(48% 0%, 100% 0%, 100% 100%, 38% 100%)"
		aria-hidden="true"
	>
		<div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${hero.image}')`}></div>
		<div class="absolute inset-0 bg-linear-to-l from-transparent via-transparent to-background/10"></div>
	</div>

	<!-- Content: centered in the left area -->
	<div
		class="relative z-10 flex min-h-[calc(100vh-5rem)] w-full flex-col items-center justify-center py-14 md:w-[42%] md:py-16 lg:py-20"
	>
		<div class="flex w-full max-w-lg flex-col">
			<div class="mb-5 flex gap-3">
				<span class="h-px w-8 shrink-0 bg-primary"></span>
				<span class="text-[11px] font-medium tracking-[0.12em] text-primary uppercase sm:text-xs">
					{hero.label}
				</span>
			</div>

			<h1
				class="mb-5 font-display text-[2.35rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-5xl lg:text-[3.2rem] lg:leading-[1.08]"
			>
				{hero.title}
			</h1>

			<p class="mb-8 max-w-md text-base leading-relaxed text-muted sm:text-lg">
				{hero.description}
			</p>

			<div class="flex flex-wrap items-center gap-3 sm:gap-4">
				<Button href={hero.primaryCta.href}>
					{hero.primaryCta.label}
					<ArrowRight class="h-4 w-4" />
				</Button>
				<Button href={hero.secondaryCta.href} variant="secondary">
					{hero.secondaryCta.label}
				</Button>
			</div>
		</div>

		<!-- Mobile image -->
		<div class="my-10 w-full overflow-hidden rounded-2xl md:hidden">
			<img src={hero.image} alt="" class="aspect-[16/10] w-full object-cover" />
		</div>

		<ul class="mt-12 grid w-full max-w-lg grid-cols-2 gap-x-5 gap-y-6 border-t border-border-light pt-8 sm:grid-cols-4">
			{
				hero.stats.map((stat) => (
					<li class="flex flex-col items-center gap-2 text-center sm:flex-row sm:items-start sm:text-left">
						<span class="shrink-0 text-primary">
							{stat.icon === 'building' && (
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M4 21V5a1 1 0 0 1 1-1h6v17M11 21h9V9a1 1 0 0 0-1-1h-8M7 8h1M7 12h1M7 16h1M15 12h1M15 16h1" />
								</svg>
							)}
							{stat.icon === 'buildings' && (
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 21h18M6 21V7l6-3v17M14 21V10l4 2v9M9 9h.01M9 13h.01M9 17h.01M16 14h.01M16 17h.01" />
								</svg>
							)}
							{stat.icon === 'award' && (
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" />
									<path d="m8.5 13.5-1 7.5L12 18l4.5 3-1-7.5" />
								</svg>
							)}
							{stat.icon === 'pin' && (
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
									<circle cx="12" cy="10" r="2.5" />
								</svg>
							)}
						</span>
						<span>
							<span class="block font-display text-sm font-bold text-heading">{stat.value}</span>
							<span class="block text-xs leading-snug text-muted">{stat.label}</span>
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
