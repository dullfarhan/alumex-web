---
import { Image } from 'astro:assets';
import { finishes } from '../../config/finishes';
import Container from '../layout/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="finishes" class="overflow-x-clip bg-background">
	<Container>
		<SectionHeader
			title={finishes.title}
			description={finishes.description}
			class="mb-12 md:mb-14"
		/>

		<ul
			class="grid grid-cols-1 gap-5 sm:gap-6"
			data-anim-stagger
		>
			{
				finishes.items.map((item) => (
					<li class="min-w-0">
						<a
							href={item.href}
							class="group relative block h-[100px] sm:h-[150px] w-full overflow-hidden rounded-2xl shadow-[0_12px_32px_rgba(18,43,77,0.18)] transition-transform duration-500 ease-out hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(18,43,77,0.24)]"
						>
							<Image
								src={item.image}
								alt={item.title}
								widths={[400, 640, 960]}
								sizes="(max-width: 640px) 100vw, 33vw"
								class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-primary-dark/40 transition-colors duration-300 group-hover:bg-primary-dark/50"></div>
							<div class="pointer-events-none absolute inset-x-0 bottom-0 pt-20 pb-6 text-center sm:px-6 sm:pb-7">
								<h3 class="font-display text-base font-bold tracking-wide text-white drop-shadow-sm sm:text-lg md:text-xl">
									{item.title}
								</h3>
								<span class="mt-2 inline-block text-xs tracking-wide text-white/80 uppercase">
									View details
								</span>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</Container>
</section>
