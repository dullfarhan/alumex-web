---
import { Image } from 'astro:assets';
import { finishes } from '../../config/finishes';
import Container from '../layout/Container.astro';
---

<section id="finishes" class="overflow-x-clip bg-background">
	<Container>
		<div class="mb-12 text-center md:mb-14">
			<span class="mb-4 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{finishes.label}</span>
			<h2 class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[3.1rem]">
				{finishes.title}
			</h2>
			<p class="mx-auto max-w-2xl text-base leading-relaxed text-muted md:text-lg">{finishes.description}</p>
		</div>

		<ul class="grid grid-cols-2 gap-4 pb-2 md:grid-cols-3 md:gap-5 lg:grid-cols-6">
			{
				finishes.items.map((item) => (
					<li class="min-w-0">
						<div class="group relative h-64 w-full origin-center overflow-hidden shadow-[8px_16px_32px_rgba(18,43,77,0.28)] transition-transform duration-500 ease-out [transform:perspective(900px)_rotateY(-16deg)] hover:z-10 hover:[transform:perspective(900px)_rotateY(-16deg)_scale(1.08)] sm:h-72 md:h-80 lg:h-[400px]">
							<Image
								src={item.image}
								alt={item.title}
								widths={[320, 480, 640]}
								sizes="(max-width: 768px) 50vw, 33vw"
								class="absolute inset-0 h-full w-full object-cover"
							/>
							<div class="absolute inset-0 bg-primary-dark/45 transition-colors duration-300 group-hover:bg-primary-dark/55"></div>
							<div class="pointer-events-none absolute inset-y-0 left-0 w-1/4 bg-linear-to-r from-white/25 to-transparent opacity-70"></div>
							<div class="pointer-events-none absolute inset-y-0 right-0 w-1/5 bg-linear-to-l from-black/35 to-transparent"></div>
							<div class="absolute inset-x-0 bottom-0 px-4 pt-16 pb-6 text-center sm:px-5 sm:pb-7">
								<h3 class="font-display text-sm font-bold tracking-wide text-white drop-shadow-sm sm:text-base md:text-lg">
									{item.title}
								</h3>
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</Container>
</section>
