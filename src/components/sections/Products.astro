---
import { products } from '../../config/products';
import ArrowRight from '../icons/ArrowRight.astro';
import Button from '../ui/Button.astro';
import Container from '../layout/Container.astro';
import MobileCarousel from '../ui/MobileCarousel.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ProductCard from './products/ProductCard.astro';

const featuredProducts = (['Doors', 'Windows', 'Facades'] as const)
	.map((category) => products.items.find((item) => item.category === category))
	.filter((item): item is (typeof products.items)[number] => Boolean(item));
---

<section id="products" class="bg-background">
	<Container class="!px-0 sm:!px-12 md:py-16">
		<div class="bg-[#e8f1fa] px-6 py-10 text-center sm:rounded-4xl sm:px-8 md:px-12 md:py-14">
			<SectionHeader title={products.title} description={products.description} class="mb-12" />

			{/* Carousel only on small screens */}
			<div class="sm:hidden">
				<MobileCarousel label="Featured products" desktopClass="min-w-0 w-full text-left sm:grid sm:grid-cols-1 sm:gap-6 lg:grid-cols-2 lg:gap-7 lg:[&>*:last-child:nth-child(odd)]:col-span-2 lg:[&>*:last-child:nth-child(odd)]:mx-auto lg:[&>*:last-child:nth-child(odd)]:max-w-[calc(50%-0.875rem)] 2xl:grid-cols-3 2xl:gap-8 2xl:[&>*:last-child:nth-child(odd)]:col-span-1 2xl:[&>*:last-child:nth-child(odd)]:max-w-none">
					{featuredProducts.map((item, index) => <ProductCard product={item} index={index} />)}
				</MobileCarousel>
			</div>

			{/* Plain grid/flex on larger screens */}
			<div class="hidden flex-wrap justify-center gap-6 sm:flex">
				{featuredProducts.map((item, index) => <ProductCard product={item} index={index} />)}
			</div>

			<Button href="/products" class="mt-10 !rounded-full">
				View all systems
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>
		</div>
	</Container>
</section>
