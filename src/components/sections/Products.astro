---
import { Image } from 'astro:assets';
import { products } from '../../config/products';
import ArrowRight from '../icons/ArrowRight.astro';
import Button from '../ui/Button.astro';
import Container from '../layout/Container.astro';

const featuredProducts = products.items.slice(0, 3);
---

<section id="products" class="bg-background">
	<Container class="!px-0 sm:!px-12 md:py-16">
		<span class="mb-12 block text-center text-sm font-medium tracking-[0.08em] text-primary uppercase">
			{products.label}
		</span>

		<div class="bg-[#e8f1fa] px-6 py-10 text-center sm:rounded-3xl sm:px-8 md:px-12 md:py-14">
			<div class="mb-12 w-full">
				<h2
					class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl lg:text-[3.1rem]"
				>
					{products.title}
				</h2>
				<p class="mx-auto max-w-2xl text-base leading-relaxed text-muted md:text-lg">{products.description}</p>
			</div>

			<div class="grid grid-cols-1 gap-6 text-left lg:grid-cols-3 lg:gap-8">
				{
					featuredProducts.map((item) => (
						<a
							href={item.href}
							class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-[0_8px_30px_rgba(18,43,77,0.08)] transition-shadow duration-300 hover:shadow-[0_12px_36px_rgba(18,43,77,0.12)]"
						>
							<div class="relative">
								<div class="overflow-hidden">
									<Image
										src={item.image}
										alt={item.title}
										widths={[400, 600, 800]}
										sizes="(max-width: 1024px) 100vw, 33vw"
										class="aspect-[5/3] w-full object-cover transition-transform duration-700 group-hover:scale-105"
									/>
								</div>
							</div>

							<div class="flex flex-1 flex-col px-5 py-6">
								<h3 class="mb-2 font-display text-xl font-bold text-heading">{item.title}</h3>
								<p class="mb-5 flex-1 text-sm leading-relaxed text-muted">{item.shortDescription}</p>
								<span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
									Explore System
									<ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
								</span>
							</div>
						</a>
					))
				}
			</div>

			<Button href="/products" class="mt-10">
				View all systems
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>
		</div>
	</Container>
</section>
