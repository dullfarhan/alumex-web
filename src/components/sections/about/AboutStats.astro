---
import { about } from '../../../config/about';
import Container from '../../layout/Container.astro';
---

<section class="border-y border-silver/40 bg-background-alt">
	<Container class="!py-10 md:!py-12">
		<div class="mb-8 text-center md:mb-10">
			<span class="mb-2 block text-sm font-medium tracking-[0.08em] text-primary uppercase">Production plants</span>
			<p class="mx-auto max-w-2xl text-sm leading-relaxed text-muted md:text-base">
				Continuously modernizing our production facility with imported tools and machinery.
			</p>
		</div>
		<ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
			{
				about.stats.map((stat) => (
					<li>
						<p class="mb-1.5 text-xs font-medium tracking-[0.08em] text-muted uppercase">{stat.label}</p>
						<p class="font-display text-lg font-bold tracking-tight text-heading md:text-xl">{stat.value}</p>
					</li>
				))
			}
		</ul>
	</Container>
</section>
