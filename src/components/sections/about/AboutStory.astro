---
import { Image } from 'astro:assets';
import { about } from '../../../config/about';
import Container from '../../layout/Container.astro';
---

<section class="bg-background">
	<Container>
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<div>
				<span class="mb-4 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{about.story.label}</span>
				<h2 class="mb-6 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[2.75rem]">
					{about.story.title}
				</h2>
				<div class="space-y-4">
					{
						about.story.paragraphs.map((paragraph) => (
							<p class="text-base leading-relaxed text-muted md:text-lg">{paragraph}</p>
						))
					}
				</div>
			</div>

			<div class="overflow-hidden rounded-xl">
				<Image
					src={about.story.image}
					alt={about.story.imageAlt}
					widths={[640, 960, 1200]}
					sizes="(max-width: 1024px) 100vw, 50vw"
					class="aspect-[4/3] w-full object-cover"
				/>
			</div>
		</div>
	</Container>
</section>
