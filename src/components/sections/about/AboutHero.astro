---
import { about } from '../../../config/about';
import Container from '../../layout/Container.astro';
---

<section class="border-b border-silver/40 bg-background-alt">
	<Container>
		<div class="w-full text-center">
			<span class="mb-4 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{about.label}</span>
			<h1 class="mb-4 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[3.1rem]">
				{about.title}
			</h1>
			<p class="text-base leading-relaxed text-muted md:text-lg">{about.description}</p>
		</div>
	</Container>
</section>
