---
import { about } from '../../../config/about';
import Container from '../../layout/Container.astro';
---

<section class="bg-background">
	<Container>
		<div class="mb-12 md:mb-14 text-center">
			<span class="mb-4 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{about.process.label}</span>
			<h2 class="font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[2.75rem]">
				{about.process.title}
			</h2>
		</div>

		<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
			{
				about.process.steps.map((step) => (
					<li class="border-t border-silver/60 pt-6">
						<span class="mb-3 block font-display text-sm font-semibold tracking-wide text-primary">{step.number}</span>
						<h3 class="mb-2 font-display text-lg font-bold text-heading">{step.title}</h3>
						<p class="text-sm leading-relaxed text-muted">{step.description}</p>
					</li>
				))
			}
		</ol>
	</Container>
</section>
