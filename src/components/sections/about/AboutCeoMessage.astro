---
import { about } from '../../../config/about';
import Container from '../../layout/Container.astro';

const { ceoMessage } = about;
---

<section id="ceo-message">
	<Container class="!pt-16 md:!pt-24 !pb-0">
		<div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
			<div>
				<span class="mb-4 block text-sm font-medium tracking-[0.08em] text-primary uppercase">{ceoMessage.label}</span>
				<h2 class="mb-6 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-heading sm:text-3xl md:text-[2.75rem]">
					{ceoMessage.title}
				</h2>
				{
					(ceoMessage.name || ceoMessage.role) && (
						<div>
							{ceoMessage.name && <p class="font-display text-lg font-bold text-heading">{ceoMessage.name}</p>}
							{ceoMessage.role && <p class="text-sm font-medium tracking-wide text-primary uppercase">{ceoMessage.role}</p>}
						</div>
					)
				}
			</div>

			<p class="text-base leading-relaxed text-muted first-letter:float-left first-letter:mr-3 first-letter:font-display first-letter:text-5xl first-letter:leading-[0.85] first-letter:font-bold first-letter:text-heading md:text-lg md:first-letter:text-6xl">
				{ceoMessage.text}
			</p>
		</div>
	</Container>
</section>
