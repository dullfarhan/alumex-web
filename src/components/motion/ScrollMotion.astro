---
// Site-wide scroll motion. Drive it from markup, no per-section scripts:
//   data-anim="up|down|left|right|scale"  reveal once on enter
//   data-anim-delay="0.2"                 seconds
//   data-anim-stagger                     reveal direct children in sequence
//   data-parallax="0.2"                   scrubbed drift, fraction of viewport
//   data-count="500" data-count-suffix="+"
---

<style is:global>
	.js [data-anim],
	.js [data-anim-stagger] > * {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.js [data-anim],
		.js [data-anim-stagger] > * {
			opacity: 1;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const offsets: Record<string, gsap.TweenVars> = {
		up: { y: 44 },
		down: { y: -44 },
		left: { x: -44 },
		right: { x: 44 },
		scale: { scale: 0.94 },
	};

	const counters = document.querySelectorAll<HTMLElement>('[data-count]');

	const runCounter = (el: HTMLElement) => {
		const target = Number(el.dataset.count);
		const suffix = el.dataset.countSuffix ?? '';
		if (!Number.isFinite(target)) return;
		if (reduced) {
			el.textContent = `${target}${suffix}`;
			return;
		}
		const state = { value: 0 };
		gsap.to(state, {
			value: target,
			duration: 1.6,
			ease: 'power2.out',
			onUpdate: () => {
				el.textContent = `${Math.round(state.value)}${suffix}`;
			},
			scrollTrigger: { trigger: el, start: 'top 92%', once: true },
		});
	};

	counters.forEach(runCounter);

	if (!reduced) {
		document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
			gsap.fromTo(
				el,
				{ opacity: 0, ...(offsets[el.dataset.anim ?? ''] ?? offsets.up) },
				{
					opacity: 1,
					x: 0,
					y: 0,
					scale: 1,
					duration: 0.9,
					ease: 'power3.out',
					delay: Number(el.dataset.animDelay) || 0,
					scrollTrigger: { trigger: el, start: 'top 88%', once: true },
				},
			);
		});

		document.querySelectorAll<HTMLElement>('[data-anim-stagger]').forEach((el) => {
			gsap.fromTo(
				el.children,
				{ opacity: 0, y: 44 },
				{
					opacity: 1,
					y: 0,
					duration: 0.8,
					ease: 'power3.out',
					stagger: 0.12,
					scrollTrigger: { trigger: el, start: 'top 88%', once: true },
				},
			);
		});

		document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
			const depth = Number(el.dataset.parallax) || 0.15;
			gsap.fromTo(
				el,
				{ y: () => window.innerHeight * depth * 0.5 },
				{
					y: () => window.innerHeight * depth * -0.5,
					ease: 'none',
					scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true },
				},
			);
		});
	}
</script>
