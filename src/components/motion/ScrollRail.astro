---
// Fixed side indicator. Labels come from any element carrying data-rail="Label".
---

<aside class="rail" data-rail-root aria-hidden="true">
	<span class="rail__glyph" data-rail-glyph>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
			<rect x="3" y="3" width="18" height="18" rx="1"></rect>
			<rect x="8" y="8" width="8" height="8" rx="1"></rect>
		</svg>
	</span>

	<span class="rail__percent" data-rail-percent>00</span>

	<span class="rail__track">
		<span class="rail__fill" data-rail-fill></span>
	</span>

	<span class="rail__label" data-rail-label></span>
</aside>

<style>
	.rail {
		position: fixed;
		right: 1.25rem;
		top: 50%;
		z-index: 30;
		display: none;
		translate: 0 -50%;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		pointer-events: none;
	}

	@media (min-width: 1280px) {
		.rail {
			display: flex;
		}
	}

	.rail__glyph {
		display: block;
		width: 1.25rem;
		color: var(--primary);
		opacity: 0.7;
	}

	.rail__percent,
	.rail__label {
		font-family: var(--font-display);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.rail__track {
		position: relative;
		display: block;
		height: 8rem;
		width: 2px;
		background: var(--border);
	}

	.rail__fill {
		position: absolute;
		inset: 0;
		display: block;
		background: var(--brand-gradient);
		transform-origin: top center;
		scale: 1 0;
	}

	.rail__label {
		writing-mode: vertical-rl;
		color: var(--primary);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.rail {
			display: none;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const root = document.querySelector<HTMLElement>('[data-rail-root]');
	const fill = document.querySelector<HTMLElement>('[data-rail-fill]');
	const percent = document.querySelector<HTMLElement>('[data-rail-percent]');
	const label = document.querySelector<HTMLElement>('[data-rail-label]');
	const glyph = document.querySelector<HTMLElement>('[data-rail-glyph]');
	const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-rail]'));

	if (root && fill && percent && label && glyph && sections.length) {
		ScrollTrigger.create({
			trigger: document.documentElement,
			start: 'top top',
			end: 'bottom bottom',
			onUpdate: (self) => {
				gsap.set(fill, { scaleY: self.progress });
				gsap.set(glyph, { rotate: self.progress * 180 });
				percent.textContent = String(Math.round(self.progress * 100)).padStart(2, '0');
			},
		});

		const setLabel = (text: string) => {
			if (label.textContent === text) return;
			gsap.to(label, {
				opacity: 0,
				duration: 0.15,
				onComplete: () => {
					label.textContent = text;
					gsap.to(label, { opacity: 1, duration: 0.25 });
				},
			});
		};

		label.textContent = sections[0].dataset.rail ?? '';

		sections.forEach((section) => {
			ScrollTrigger.create({
				trigger: section,
				start: 'top center',
				end: 'bottom center',
				onToggle: (self) => {
					if (self.isActive) setLabel(section.dataset.rail ?? '');
				},
			});
		});
	}
</script>
