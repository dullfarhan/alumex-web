---
import { Image } from 'astro:assets';
import logo from '../../assets/logo-white.png';
import { footer } from '../../config/footer';
import { site } from '../../config/site';
import ArrowRight from '../icons/ArrowRight.astro';
import Container from './Container.astro';
---

<footer class="bg-primary-dark text-white">
	<Container class="!py-6 md:!py-10 md:!pb-8 flex flex-col gap-6">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-8">
			<!-- Brand + plant info -->
			<div>
				<a href="/" class="mb-5 inline-flex items-center gap-3">
					<Image
						src={logo}
						alt={`${site.name} logo`}
						width={192}
						height={192}
						densities={[1, 2, 3]}
						sizes="(max-width: 640px) 7rem, 11.5rem"
						class="h-28 w-28 shrink-0 rounded-full object-contain sm:h-46 sm:w-46"
					/>
				</a>
			</div>

			{
				footer.columns.map((column) => (
					<nav aria-label={column.title}>
						<h3 class="mb-4 font-display text-sm font-semibold tracking-wide text-white">{column.title}</h3>
						<ul class="space-y-3">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-white/65 transition-colors hover:text-white"
										{...('external' in link && link.external
											? { target: '_blank', rel: 'noopener noreferrer' }
											: {})}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}

			<!-- Hours + quote CTA -->
			<div class="flex flex-col gap-5">
				<div>
				<p class="mb-5 text-sm text-white/65">{footer.hours}</p>
				<a
					href="/contact"
					class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-primary-dark transition-colors hover:bg-accent hover:text-white"
				>
					Contact Us
					<ArrowRight class="h-3.5 w-3.5" />
				</a>
			</div>
				<ul class="space-y-2.5 text-sm text-white/75">
					<li>{site.address}</li>
					<li>
						<a href={`mailto:${site.email}`} class="transition-colors hover:text-white">{site.email}</a>
					</li>
					<li>
						<a href={`tel:${site.phone.replace(/\s/g, '')}`} class="transition-colors hover:text-white">
							{site.phone}
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="flex flex-col items-center justify-center gap-3 text-center text-xs text-white/45">
			<p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
		</div>
	</Container>
</footer>
