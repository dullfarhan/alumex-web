---
import { projectsMega } from '../../../config/nav-mega';
import ChevronRight from '../../icons/ChevronRight.astro';
import MegaMenuColumn from './MegaMenuColumn.astro';
import MegaMenuFeatured from './MegaMenuFeatured.astro';

const [projectsColumn, finishesColumn] = projectsMega.columns;
---

<div
	id="projects-mega"
	class="absolute inset-x-0 top-full z-40 mt-3 border border-white/10 bg-primary-dark shadow-xl max-md:hidden before:absolute before:inset-x-0 before:-top-5 before:h-5 before:content-['']"
	hidden
	data-projects-mega
>
	<div class="mx-auto grid max-w-[1440px] gap-10 px-6 py-10 sm:px-12 lg:grid-cols-3 lg:gap-0 lg:divide-x lg:divide-white/10 lg:py-12">
		<div class="lg:px-8 first:lg:pl-0">
			<h3 class="mb-4 text-xs font-medium tracking-[0.08em] text-accent uppercase">{projectsColumn.title}</h3>
			<ul class="space-y-3">
				{
					projectsColumn.links.map((link, index) => (
						<li>
							<a
								href={link.href}
								data-projects-preview-trigger={'slug' in link ? link.slug : undefined}
								aria-current={index === 0 ? 'true' : undefined}
								class:list={[
									'text-sm transition-colors',
									index === 0 ? 'text-white' : 'text-white/70 hover:text-white',
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			{
				'footers' in projectsColumn && projectsColumn.footers && (
					<div class="mt-5 flex flex-col items-start gap-3">
						{projectsColumn.footers.map((item) => (
							<a
								href={item.href}
								class="inline-flex items-center gap-1 border-b border-accent pb-0.5 text-sm font-medium text-accent transition-colors hover:border-white hover:text-white"
							>
								{item.label}
								<ChevronRight class="h-3.5 w-3.5" />
							</a>
						))}
					</div>
				)
			}
		</div>

		<div class="lg:px-8">
			<MegaMenuColumn title={finishesColumn.title} links={finishesColumn.links} />
		</div>

		<div class="lg:px-8 lg:pr-0">
			<MegaMenuFeatured label={projectsMega.featured.label} cta={projectsMega.featured.cta} items={projectsMega.featured.items} />
		</div>
	</div>
</div>

<script>
	const mega = document.querySelector('[data-projects-mega]');
	if (mega) {
		const triggers = mega.querySelectorAll<HTMLAnchorElement>('[data-projects-preview-trigger]');
		const panels = mega.querySelectorAll<HTMLElement>('[data-projects-preview-panel]');

		const setActive = (slug: string) => {
			triggers.forEach((trigger) => {
				const active = trigger.dataset.projectsPreviewTrigger === slug;
				trigger.toggleAttribute('aria-current', active);
				trigger.classList.toggle('text-white', active);
				trigger.classList.toggle('text-white/70', !active);
			});
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.projectsPreviewPanel !== slug;
			});
		};

		triggers.forEach((trigger) => {
			trigger.addEventListener('mouseenter', () => setActive(trigger.dataset.projectsPreviewTrigger ?? ''));
			trigger.addEventListener('focus', () => setActive(trigger.dataset.projectsPreviewTrigger ?? ''));
		});
	}
</script>
