---
import { Image } from 'astro:assets';
import { productsMega } from '../../../config/nav-mega';
import ChevronRight from '../../icons/ChevronRight.astro';

const categories = productsMega.categories;
---

<div
	id="products-mega"
	class="absolute inset-x-0 top-full z-40 border-t border-white/10 bg-primary-dark text-white shadow-xl max-md:hidden"
	hidden
	data-products-mega
>
	<div class="mx-auto max-w-[1440px]">
		<div class="grid lg:grid-cols-12">
			<!-- Category sidebar -->
			<aside class="border-b border-white/10 bg-black/20 lg:col-span-3 lg:border-r lg:border-b-0">
				<ul class="py-2" role="tablist" aria-label="Product categories">
					{
						categories.map((category, index) => (
							<li>
								<a
									href={category.href}
									role="tab"
									id={`products-tab-${category.id}`}
									aria-selected={index === 0 ? 'true' : 'false'}
									aria-controls={`products-panel-${category.id}`}
									data-products-tab={category.id}
									class:list={[
										'group flex w-full items-center justify-between gap-3 px-6 py-3.5 text-left text-sm transition-colors sm:px-8',
										index === 0
											? 'bg-white/10 text-white'
											: 'text-white/75 hover:bg-white/5 hover:text-white',
									]}
								>
									<span class="font-medium">{category.title}</span>
									<ChevronRight
										class:list={[
											'h-3.5 w-3.5 shrink-0',
											index === 0 ? 'text-accent' : 'text-white/40 group-hover:text-white/70',
										]}
									/>
								</a>
							</li>
						))
					}
				</ul>
				<a
					href={productsMega.viewAll.href}
					class="mx-6 mb-5 mt-2 inline-flex items-center gap-1 border-b border-accent pb-0.5 text-sm font-medium text-accent transition-colors hover:border-white hover:text-white sm:mx-8"
				>
					{productsMega.viewAll.label}
					<ChevronRight class="h-3.5 w-3.5" />
				</a>
			</aside>

			<!-- Panels -->
			<div class="lg:col-span-9">
				{
					categories.map((category, index) => (
						<div
							id={`products-panel-${category.id}`}
							role="tabpanel"
							aria-labelledby={`products-tab-${category.id}`}
							data-products-panel={category.id}
							hidden={index !== 0}
							class="grid gap-8 px-6 py-8 sm:px-8 lg:grid-cols-5 lg:gap-10 lg:px-10 lg:py-10"
						>
							<div class="space-y-8 lg:col-span-3">
								<div>
									<h3 class="mb-4 text-xs font-medium tracking-[0.08em] text-accent uppercase">Overview</h3>
									<p class="mb-3 max-w-xl text-sm leading-relaxed text-white/70">{category.description}</p>
									<a
										href={category.href}
										class="inline-flex items-center gap-1 text-sm font-medium text-accent transition-colors hover:text-white"
									>
										View details
										<ChevronRight class="h-3.5 w-3.5" />
									</a>
								</div>

								<div>
									<h3 class="mb-4 text-xs font-medium tracking-[0.08em] text-accent uppercase">Performance</h3>
									<ul class="grid gap-4 sm:grid-cols-3">
										{category.capabilities.map((item) => (
											<li class="border-t border-white/15 pt-3">
												<p class="mb-1 font-display text-sm font-semibold text-white">{item.label}</p>
												<p class="text-xs leading-relaxed text-white/55">{item.description}</p>
											</li>
										))}
									</ul>
								</div>

								<div class="grid gap-8 sm:grid-cols-2">
									<div>
										<h3 class="mb-4 text-xs font-medium tracking-[0.08em] text-accent uppercase">Surface finishes</h3>
										<ul class="space-y-2.5">
											{category.finishes.map((finish) => (
												<li>
													<a href={finish.href} class="text-sm text-white/70 transition-colors hover:text-white">
														{finish.label}
													</a>
												</li>
											))}
										</ul>
									</div>
									<div>
										<h3 class="mb-4 text-xs font-medium tracking-[0.08em] text-accent uppercase">Specifications</h3>
										<ul class="space-y-2.5">
											{category.specs.map((spec) => (
												<li class="flex justify-between gap-4 text-sm">
													<span class="text-white/50">{spec.label}</span>
													<span class="text-right text-white/85">{spec.value}</span>
												</li>
											))}
										</ul>
									</div>
								</div>
							</div>

							<a href={category.href} class="group relative block overflow-hidden rounded-lg lg:col-span-2">
								<Image
									src={category.image}
									alt={category.imageAlt}
									widths={[400, 640, 800]}
									sizes="(max-width: 1024px) 100vw, 320px"
									class="aspect-[4/5] h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
								/>
								<div class="absolute inset-0 bg-linear-to-t from-primary-dark/90 via-primary-dark/20 to-transparent"></div>
								<div class="absolute inset-x-0 bottom-0 p-5">
									<p class="mb-1 font-display text-lg font-bold text-white">{category.title}</p>
									<span class="inline-flex items-center gap-1 text-sm font-medium text-white/90">
										View details
										<ChevronRight class="h-3.5 w-3.5" />
									</span>
								</div>
							</a>
						</div>
					))
				}
			</div>
		</div>

		<!-- Bottom tiles -->
		<ul class="grid gap-px border-t border-white/10 bg-white/10 sm:grid-cols-3">
			{
				productsMega.footerTiles.map((tile) => (
					<li class="bg-primary-dark">
						<a href={tile.href} class="block px-6 py-5 transition-colors hover:bg-white/5 sm:px-8">
							<p class="mb-1 font-display text-sm font-semibold text-white">{tile.title}</p>
							<p class="text-xs leading-relaxed text-white/55">{tile.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</div>

<script>
	const mega = document.querySelector('[data-products-mega]');
	if (mega) {
		const tabs = mega.querySelectorAll<HTMLAnchorElement>('[data-products-tab]');
		const panels = mega.querySelectorAll<HTMLElement>('[data-products-panel]');

		const setActive = (id: string) => {
			tabs.forEach((tab) => {
				const active = tab.dataset.productsTab === id;
				tab.setAttribute('aria-selected', String(active));
				tab.classList.toggle('bg-white/10', active);
				tab.classList.toggle('text-white', active);
				tab.classList.toggle('text-white/75', !active);
				const icon = tab.querySelector('svg');
				if (icon) {
					icon.classList.toggle('text-accent', active);
					icon.classList.toggle('text-white/40', !active);
				}
			});
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.productsPanel !== id;
			});
		};

		tabs.forEach((tab) => {
			tab.addEventListener('mouseenter', () => setActive(tab.dataset.productsTab ?? ''));
			tab.addEventListener('focus', () => setActive(tab.dataset.productsTab ?? ''));
		});
	}
</script>
