---
import ChevronRight from '../../icons/ChevronRight.astro';

interface Link {
	label: string;
	href: string;
}

interface Props {
	title: string;
	links: readonly Link[];
	footer?: Link;
	footers?: readonly Link[];
	variant?: 'dark' | 'light';
}

const { title, links, footer, footers, variant = 'dark' } = Astro.props;
const isDark = variant === 'dark';
const footerLinks = footers ?? (footer ? [footer] : []);
---

<div>
	<h3
		class:list={[
			'mb-4 text-xs font-medium tracking-[0.08em] uppercase',
			isDark ? 'text-accent' : 'text-primary',
		]}
	>
		{title}
	</h3>
	<ul class="space-y-3">
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						class:list={[
							'text-sm transition-colors',
							isDark ? 'text-white/70 hover:text-white' : 'text-heading/80 hover:text-primary',
						]}
					>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
	{
		footerLinks.length > 0 && (
			<div class="mt-5 flex flex-col items-start gap-3">
				{footerLinks.map((item) => (
					<a
						href={item.href}
						class:list={[
							'inline-flex items-center gap-1 border-b pb-0.5 text-sm font-medium transition-colors',
							isDark
								? 'border-accent text-accent hover:border-white hover:text-white'
								: 'border-primary text-primary hover:text-primary-dark',
						]}
					>
						{item.label}
						<ChevronRight class="h-3.5 w-3.5" />
					</a>
				))}
			</div>
		)
	}
</div>
