---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { navCta, navLinks } from '../../config/navigation';
import { site } from '../../config/site';
import ArrowRight from '../icons/ArrowRight.astro';
import Button from '../ui/Button.astro';
import NavLink from '../ui/NavLink.astro';
import Container from './Container.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-silver/40 bg-background/95 backdrop-blur-sm">
	<nav
		class="relative flex h-16 w-full items-center justify-between px-6 sm:px-12 md:h-20"
		aria-label="Main navigation"
	>
		<a href="/" class="z-10 flex items-center gap-3">
			<Image
				src={logo}
				alt={`${site.name} logo`}
				width={56}
				height={56}
				densities={[1, 2]}
				class="h-11 w-11 rounded-full object-cover sm:h-13 sm:w-13"
			/>
			<span class="hidden font-display text-lg font-bold tracking-tight text-heading sm:block">{site.name}</span>
		</a>

		<ul class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 md:flex lg:gap-10">
			{
				navLinks.map(({ href, label }) => (
					<li>
						<NavLink href={href} active={currentPath === href}>
							{label}
						</NavLink>
					</li>
				))
			}
		</ul>

		<div class="z-10 flex items-center gap-3">
			<Button href={navCta.href} size="sm" class="!hidden sm:!inline-flex">
				{navCta.label}
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>

			<button
				id="nav-toggle"
				type="button"
				class="group flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-lg border border-border-light bg-background md:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Open menu"
			>
				<span class="h-0.5 w-5 rounded-full bg-heading transition-all duration-300 group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45"></span>
				<span class="h-0.5 w-5 rounded-full bg-heading transition-all duration-300 group-aria-expanded:opacity-0"></span>
				<span class="h-0.5 w-5 rounded-full bg-heading transition-all duration-300 group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45"></span>
			</button>
		</div>
	</nav>

	<!-- Absolute overlay under header — covers content, no page shift / no scroll lock -->
	<div
		id="mobile-nav"
		class="absolute inset-x-0 top-full z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-border-light bg-background shadow-lg md:hidden"
		hidden
	>
		<Container class="py-4">
			<ul class="flex flex-col gap-1">
				{
					navLinks.map(({ href, label }) => (
						<li>
							<NavLink href={href} active={currentPath === href} mobile>
								{label}
							</NavLink>
						</li>
					))
				}
			</ul>
			<Button href={navCta.href} class="mt-4 mb-2 w-full justify-center sm:hidden">
				{navCta.label}
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>
		</Container>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('mobile-nav');

	const setOpen = (open: boolean) => {
		if (!toggle || !menu) return;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		menu.hidden = !open;
	};

	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			setOpen(!open);
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		// Close if viewport grows to desktop
		window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
			if (e.matches) setOpen(false);
		});
	}
</script>
