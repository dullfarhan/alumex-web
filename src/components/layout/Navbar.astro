---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { navCta, navLinks } from '../../config/navigation';
import { productsMega, projectsMega } from '../../config/nav-mega';
import { site } from '../../config/site';
import ArrowRight from '../icons/ArrowRight.astro';
import ChevronDown from '../icons/ChevronDown.astro';
import Button from '../ui/Button.astro';
import NavLink from '../ui/NavLink.astro';
import Container from './Container.astro';
import MobileProductsAccordion from './nav/MobileProductsAccordion.astro';
import MobileProjectsAccordion from './nav/MobileProjectsAccordion.astro';
import ProductsMegaMenu from './nav/ProductsMegaMenu.astro';
import ProjectsMegaMenu from './nav/ProjectsMegaMenu.astro';

const currentPath = Astro.url.pathname;
const megaLabels = new Set(['Products', 'Projects']);
const simpleLinks = navLinks.filter((link) => !megaLabels.has(link.label));

const triggerClass =
	'group flex h-full items-center gap-1.5 px-1 text-sm font-medium text-heading transition-colors duration-300 hover:text-primary aria-expanded:text-primary';
const triggerLabelClass =
	'relative inline-flex items-center gap-1.5 pb-1 after:absolute after:right-0 after:bottom-0 after:left-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-primary after:transition-transform after:duration-300 after:ease-out group-hover:after:scale-x-100 group-aria-expanded:after:scale-x-100';
---

<header id="site-header" class="sticky top-0 z-50 border-b border-silver/40 bg-background/95 backdrop-blur-sm">
	<nav
		class="relative mx-auto grid h-16 w-full max-w-[1440px] grid-cols-[1fr_auto_1fr] items-stretch px-6 sm:px-12 md:h-20"
		aria-label="Main navigation"
	>
		<a href="/" class="z-10 col-start-1 flex items-center gap-3 justify-self-start">
			<Image
				src={logo}
				alt={`${site.name} logo`}
				width={128}
				height={128}
				densities={[1, 2, 3]}
				sizes="(max-width: 640px) 2.75rem, 3.25rem"
				class="h-11 w-11 shrink-0 rounded-full object-contain sm:h-13 sm:w-13"
			/>
			<span class="font-display block text-lg font-bold tracking-tight text-heading">{site.name}</span>
		</a>

		<ul class="col-start-2 hidden h-full items-stretch gap-6 justify-self-center lg:flex lg:gap-8">
			{
				navLinks.map(({ href, label }) => {
					if (label === 'Products') {
						return (
							<li class="h-full" data-mega-wrap="products">
								<button
									id="products-mega-trigger"
									type="button"
									class={triggerClass}
									aria-expanded="false"
									aria-controls="products-mega"
									aria-haspopup="true"
								>
									<span class={triggerLabelClass}>
										{productsMega.trigger.label}
										<ChevronDown class="h-3.5 w-3.5 transition-transform duration-300 group-aria-expanded:rotate-180" />
									</span>
								</button>
							</li>
						);
					}
					if (label === 'Projects') {
						return (
							<li class="h-full" data-mega-wrap="projects">
								<button
									id="projects-mega-trigger"
									type="button"
									class={triggerClass}
									aria-expanded="false"
									aria-controls="projects-mega"
									aria-haspopup="true"
								>
									<span class={triggerLabelClass}>
										{projectsMega.trigger.label}
										<ChevronDown class="h-3.5 w-3.5 transition-transform duration-300 group-aria-expanded:rotate-180" />
									</span>
								</button>
							</li>
						);
					}
					return (
						<li class="h-full">
							<NavLink href={href} active={currentPath === href}>
								{label}
							</NavLink>
						</li>
					);
				})
			}
		</ul>

		<div class="z-10 col-start-3 flex items-center gap-3 justify-self-end">
			<Button href={navCta.href} size="sm" class="!hidden md:!inline-flex">
				{navCta.label}
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>

			<button
				id="nav-toggle"
				type="button"
				class="group flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-lg border border-border-light bg-background lg:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Open menu"
			>
				<span class="h-0.5 w-5 rounded-full bg-heading transition-all duration-300 group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45"></span>
				<span class="h-0.5 w-5 rounded-full bg-heading transition-all duration-300 group-aria-expanded:opacity-0"></span>
				<span class="h-0.5 w-5 rounded-full bg-heading transition-all duration-300 group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45"></span>
			</button>
		</div>
	</nav>

	<ProductsMegaMenu />
	<ProjectsMegaMenu />

	<div
		id="mobile-nav"
		class="absolute inset-x-0 top-full z-50 max-h-[calc(100dvh-8rem)] overflow-y-auto border-b border-border-light bg-background shadow-lg lg:hidden"
		hidden
	>
		<Container class="!py-2">
			<ul class="flex flex-col">
				{
					simpleLinks.map(({ href, label }) => (
						<li class="border-b border-border-light">
							<NavLink href={href} active={currentPath === href} mobile>
								{label}
							</NavLink>
						</li>
					))
				}
				<MobileProductsAccordion />
				<MobileProjectsAccordion />
			</ul>
			<Button href={navCta.href} class="mt-4 mb-4 w-full justify-center md:hidden">
				{navCta.label}
				<ArrowRight class="h-3.5 w-3.5" />
			</Button>
		</Container>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const mobileToggle = document.getElementById('nav-toggle');
	const mobileMenu = document.getElementById('mobile-nav');

	type MegaKey = 'products' | 'projects';

	const megas: Record<MegaKey, { trigger: HTMLElement | null; panel: HTMLElement | null }> = {
		products: {
			trigger: document.getElementById('products-mega-trigger'),
			panel: document.getElementById('products-mega'),
		},
		projects: {
			trigger: document.getElementById('projects-mega-trigger'),
			panel: document.getElementById('projects-mega'),
		},
	};

	const mobileAccordions = [
		{
			toggle: document.getElementById('mobile-products-toggle'),
			panel: document.getElementById('mobile-products-panel'),
		},
		{
			toggle: document.getElementById('mobile-projects-toggle'),
			panel: document.getElementById('mobile-projects-panel'),
		},
	];

	const closeMobileAccordions = () => {
		mobileAccordions.forEach(({ toggle, panel }) => {
			toggle?.setAttribute('aria-expanded', 'false');
			if (panel) panel.hidden = true;
		});
	};

	const setMobileOpen = (open: boolean) => {
		if (!mobileToggle || !mobileMenu) return;
		mobileToggle.setAttribute('aria-expanded', String(open));
		mobileToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		mobileMenu.hidden = !open;
		if (!open) closeMobileAccordions();
	};

	const setMegaOpen = (key: MegaKey, open: boolean) => {
		const mega = megas[key];
		if (!mega.trigger || !mega.panel) return;
		mega.trigger.setAttribute('aria-expanded', String(open));
		mega.panel.hidden = !open;
		if (open) {
			(Object.keys(megas) as MegaKey[]).forEach((other) => {
				if (other !== key) setMegaOpen(other, false);
			});
			setMobileOpen(false);
		}
	};

	const closeAllMegas = () => {
		(Object.keys(megas) as MegaKey[]).forEach((key) => setMegaOpen(key, false));
	};

	if (mobileToggle && mobileMenu) {
		mobileToggle.addEventListener('click', () => {
			const open = mobileToggle.getAttribute('aria-expanded') === 'true';
			setMobileOpen(!open);
			closeAllMegas();
		});

		mobileMenu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMobileOpen(false));
		});
	}

	mobileAccordions.forEach(({ toggle, panel }) => {
		if (!toggle || !panel) return;
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			mobileAccordions.forEach(({ toggle: t, panel: p }) => {
				if (t !== toggle) {
					t?.setAttribute('aria-expanded', 'false');
					if (p) p.hidden = true;
				}
			});
			toggle.setAttribute('aria-expanded', String(!open));
			panel.hidden = open;
		});
	});

	(Object.keys(megas) as MegaKey[]).forEach((key) => {
		const { trigger, panel } = megas[key];
		if (!trigger || !panel || !header) return;

		let closeTimer: ReturnType<typeof setTimeout> | undefined;

		const openMega = () => {
			clearTimeout(closeTimer);
			setMegaOpen(key, true);
		};

		const scheduleClose = () => {
			clearTimeout(closeTimer);
			closeTimer = setTimeout(() => setMegaOpen(key, false), 200);
		};

		const wrap = header.querySelector(`[data-mega-wrap="${key}"]`);
		wrap?.addEventListener('mouseenter', openMega);
		wrap?.addEventListener('mouseleave', scheduleClose);
		panel.addEventListener('mouseenter', openMega);
		panel.addEventListener('mouseleave', scheduleClose);

		trigger.addEventListener('click', (e) => {
			e.preventDefault();
			const open = trigger.getAttribute('aria-expanded') === 'true';
			setMegaOpen(key, !open);
		});

		trigger.addEventListener('focus', openMega);

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMegaOpen(key, false));
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeAllMegas();
	});

	document.addEventListener('click', (e) => {
		const target = e.target as Node;
		if (header && !header.contains(target)) closeAllMegas();
	});

	window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
		if (e.matches) setMobileOpen(false);
		else closeAllMegas();
	});
</script>
