---
import Layout from '../../layouts/Layout.astro';
import ProductDetailHero from '../../components/sections/products/ProductDetailHero.astro';
import ProductDetailBody from '../../components/sections/products/ProductDetailBody.astro';
import ProductRelated from '../../components/sections/products/ProductRelated.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { getProductBySlug, getRelatedProducts, productItems } from '../../config/products';
import { site } from '../../config/site';

export function getStaticPaths() {
	return productItems.map((product) => ({
		params: { slug: product.slug },
	}));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug as string)!;
const related = getRelatedProducts(product.slug);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: product.title,
	description: product.description,
	image: new URL(product.image.src, site.url).href,
	brand: {
		'@type': 'Brand',
		name: site.name,
	},
	category: product.category,
	url: `${site.url}${product.href}`,
};
---

<Layout
	title={`${product.title} | ${site.name}`}
	description={product.shortDescription}
	canonical={product.href}
	jsonLd={jsonLd}
>
	<ProductDetailHero product={product} />
	<ProductDetailBody product={product} />
	<ProductRelated products={related} />
	<CtaBanner
		title="Specify this system on your next project"
		description="Share drawings or project details and our team will help with profiles, finishes, and delivery timelines."
		href="/contact"
		label="Request Quote"
	/>
</Layout>
