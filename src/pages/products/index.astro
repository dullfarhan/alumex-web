---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProductsToolbar from '../../components/sections/products/ProductsToolbar.astro';
import ProductsCatalog from '../../components/sections/products/ProductsCatalog.astro';
import { products } from '../../config/products';
---

<Layout title={products.seoTitle} description={products.seoDescription} canonical="/products">
	<PageHero label={products.label} title={products.title} description={products.description} />
	<ProductsToolbar />
	<ProductsCatalog />
</Layout>

<script>
	const search = document.getElementById('products-search') as HTMLInputElement | null;
	const chips = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
	const cards = document.querySelectorAll<HTMLElement>('[data-product-card]');
	const countEl = document.getElementById('products-count');
	const emptyEl = document.getElementById('products-empty');

	let activeCategory = 'All';

	const applyFilter = () => {
		const query = (search?.value ?? '').trim().toLowerCase();
		let visible = 0;

		cards.forEach((card) => {
			const title = card.dataset.title?.toLowerCase() ?? '';
			const category = card.dataset.category ?? '';
			const description = card.dataset.description?.toLowerCase() ?? '';
			const matchesCategory = activeCategory === 'All' || category === activeCategory;
			const matchesQuery = !query || title.includes(query) || description.includes(query) || category.toLowerCase().includes(query);
			const show = matchesCategory && matchesQuery;
			card.hidden = !show;
			card.classList.toggle('hidden', !show);
			if (show) visible += 1;
		});

		if (countEl) countEl.textContent = String(visible);
		if (emptyEl) {
			emptyEl.hidden = visible > 0;
			emptyEl.classList.toggle('hidden', visible > 0);
		}
	};

	search?.addEventListener('input', applyFilter);

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			activeCategory = chip.dataset.categoryFilter ?? 'All';
			chips.forEach((other) => {
				const active = other === chip;
				other.setAttribute('aria-pressed', String(active));
				other.classList.toggle('border-primary-dark', active);
				other.classList.toggle('bg-primary-dark', active);
				other.classList.toggle('text-white', active);
				other.classList.toggle('border-border', !active);
				other.classList.toggle('text-heading', !active);
			});
			applyFilter();
		});
	});
</script>
