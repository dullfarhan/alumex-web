---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import ProductsToolbar from '../../components/sections/products/ProductsToolbar.astro';
import ProductsCatalog from '../../components/sections/products/ProductsCatalog.astro';
import Finishes from '../../components/sections/Finishes.astro';
import Projects from '../../components/sections/Projects.astro';
import Button from '../../components/ui/Button.astro';
import CatalogueDownloadWidget from '../../components/sections/products/CatalogueDownloadWidget.astro';
import DownloadIcon from '../../components/icons/DownloadIcon.astro';
import { about } from '../../config/about';
import { productsMega } from '../../config/nav-mega';
import { products } from '../../config/products';
---

<Layout title={products.seoTitle} description={products.seoDescription} canonical="/products">
	<PageHero id="products-hero" label={products.label} title={products.title} description={products.description}>
		<Button
			href={productsMega.catalogue.href}
			download={productsMega.catalogue.filename}
			class="!rounded-full !px-8 !py-4 !text-base sm:!px-10 sm:!py-5 sm:!text-lg"
		>
			<DownloadIcon class="h-5 w-5 sm:h-6 sm:w-6" />
			{productsMega.catalogue.label}
		</Button>
	</PageHero>
	<CatalogueDownloadWidget />
	<ProductsToolbar />
	<ProductsCatalog />
	<Finishes />
	<Projects mobileCarousel />
	<CtaBanner
		title={about.cta.title}
		description={about.cta.description}
		href={about.cta.href}
		label={about.cta.label}
	/>
</Layout>

<script>
	const search = document.getElementById('products-search') as HTMLInputElement | null;
	const chips = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
	const cards = document.querySelectorAll<HTMLElement>(
		'[data-products-catalog] [data-product-card]:not([data-carousel-clone])',
	);
	const carousel = document.querySelector('[data-products-catalog] [data-mobile-carousel]');
	const countEl = document.getElementById('products-count');
	const emptyEl = document.getElementById('products-empty');

	const validCategories = new Set(
		[...chips].map((chip) => chip.dataset.categoryFilter).filter((value): value is string => Boolean(value)),
	);

	let activeCategory = 'All';

	const applyFilter = () => {
		const query = (search?.value ?? '').trim().toLowerCase();
		let visible = 0;

		cards.forEach((card) => {
			const title = card.dataset.title?.toLowerCase() ?? '';
			const category = card.dataset.category ?? '';
			const description = card.dataset.description?.toLowerCase() ?? '';
			const matchesCategory = activeCategory === 'All' || category === activeCategory;
			const matchesQuery =
				!query ||
				title.includes(query) ||
				description.includes(query) ||
				category.toLowerCase().includes(query);
			const show = matchesCategory && matchesQuery;
			card.hidden = !show;
			card.classList.toggle('hidden', !show);
			if (show) {
				visible += 1;
				const listingNumber = String(visible).padStart(2, '0');
				card.dataset.listingNumber = listingNumber;
				const label = card.querySelector<HTMLElement>('[data-listing-label]');
				if (label) label.textContent = listingNumber;
			}
		});

		if (countEl) countEl.textContent = String(visible);
		if (emptyEl) {
			emptyEl.hidden = visible > 0;
			emptyEl.classList.toggle('hidden', visible > 0);
		}

		carousel?.dispatchEvent(new Event('carousel:refresh'));
	};

	const syncCategoryToUrl = (category: string) => {
		const url = new URL(window.location.href);
		if (!category || category === 'All') url.searchParams.delete('category');
		else url.searchParams.set('category', category);
		history.replaceState({}, '', url);
	};

	const resolveCategory = (raw: string | null) => {
		if (!raw) return null;
		const value = raw.trim();
		if (!value || value.toLowerCase() === 'all') return 'All';
		const exact = [...validCategories].find((category) => category === value);
		if (exact) return exact;
		const caseInsensitive = [...validCategories].find(
			(category) => category.toLowerCase() === value.toLowerCase(),
		);
		return caseInsensitive ?? null;
	};

	const setCategory = (category: string, { syncUrl = true }: { syncUrl?: boolean } = {}) => {
		activeCategory = validCategories.has(category) ? category : 'All';
		chips.forEach((chip) => {
			const active = (chip.dataset.categoryFilter ?? 'All') === activeCategory;
			chip.setAttribute('aria-pressed', String(active));
			chip.classList.toggle('border-primary-dark', active);
			chip.classList.toggle('bg-primary-dark', active);
			chip.classList.toggle('text-white', active);
			chip.classList.toggle('border-border', !active);
			chip.classList.toggle('text-heading', !active);
		});
		applyFilter();
		if (syncUrl) syncCategoryToUrl(activeCategory);
	};

	search?.addEventListener('input', applyFilter);

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			setCategory(chip.dataset.categoryFilter ?? 'All');
		});
	});

	const categoryFromUrl = resolveCategory(new URLSearchParams(window.location.search).get('category'));
	if (categoryFromUrl) setCategory(categoryFromUrl, { syncUrl: false });
</script>
