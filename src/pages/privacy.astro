---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import LegalDoc from '../components/ui/LegalDoc.astro';
import { privacy } from '../config/privacy';
---

<Layout title={privacy.seoTitle} description={privacy.seoDescription} canonical="/privacy">
	<PageHero label={privacy.label} title={privacy.title} description={privacy.description} />
	<LegalDoc sections={privacy.sections} contactNote={privacy.contactNote} />
</Layout>
