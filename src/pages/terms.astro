---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import LegalDoc from '../components/ui/LegalDoc.astro';
import { terms } from '../config/terms';
---

<Layout title={terms.seoTitle} description={terms.seoDescription} canonical="/terms">
	<PageHero label={terms.label} title={terms.title} description={terms.description} />
	<LegalDoc sections={terms.sections} contactNote={terms.contactNote} />
</Layout>
