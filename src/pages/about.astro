---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import AboutCeoMessage from '../components/sections/about/AboutCeoMessage.astro';
import AboutStory from '../components/sections/about/AboutStory.astro';
import AboutStats from '../components/sections/about/AboutStats.astro';
import AboutFactoryGallery from '../components/sections/about/AboutFactoryGallery.astro';
import AboutProcess from '../components/sections/about/AboutProcess.astro';
import AboutQuality from '../components/sections/about/AboutQuality.astro';
import AboutCta from '../components/sections/about/AboutCta.astro';
import { about } from '../config/about';
import { site } from '../config/site';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: site.name,
	description: about.seoDescription,
	url: `${site.url}/about`,
	image: `${site.url}${site.logo}`,
	email: site.email,
	telephone: site.phone,
	address: {
		'@type': 'PostalAddress',
		streetAddress: '5km Painsra Road, Gojra',
		addressLocality: 'Faisalabad',
		postalCode: '36120',
		addressCountry: 'PK',
	},
};
---

<Layout
	title={about.seoTitle}
	description={about.seoDescription}
	canonical="/about"
	jsonLd={jsonLd}
>
	<PageHero label={about.label} title={about.title} description={about.description} />
	<AboutCeoMessage />
	<AboutStory />
	<AboutStats />
	<AboutFactoryGallery />
	<AboutProcess />
	<AboutQuality />
	<AboutCta />
</Layout>
