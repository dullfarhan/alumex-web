---
import Layout from '../layouts/Layout.astro';
import HeroExtrusion from '../components/sections/HeroExtrusion.astro';
import ScrollRail from '../components/motion/ScrollRail.astro';
import Partners from '../components/sections/Partners.astro';
import Products from '../components/sections/Products.astro';
import Finishes from '../components/sections/Finishes.astro';
import Projects from '../components/sections/Projects.astro';
import Eco from '../components/sections/Eco.astro';
import Map from '../components/sections/Map.astro';
import { site } from '../config/site';
---

<Layout title={site.title} description={site.description} canonical="/" scrollMotion={false}>
	<ScrollRail />

	<div data-rail="Intro"><HeroExtrusion /></div>
	<div data-rail="Partners"><Partners /></div>
	<div data-rail="Systems"><Products mobileCarousel /></div>
	<div data-rail="Finishes"><Finishes /></div>
	<div data-rail="Projects"><Projects mobileCarousel /></div>
	<div data-rail="Reach"><Map /></div>
	<div data-rail="Sustainability"><Eco /></div>
</Layout>
