---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import ProjectsGallery from '../../components/sections/projects/ProjectsGallery.astro';
import { projectsGallery } from '../../config/projects';
---

<Layout
	title={projectsGallery.seoTitle}
	description={projectsGallery.seoDescription}
	canonical="/projects/gallery"
>
	<ProjectsGallery />
	<CtaBanner
		title="Planning a similar project?"
		description="Share drawings or elevation details and our team will help with systems, finishes, and timelines."
		href="/contact"
		label="Request Quote"
	/>
</Layout>
