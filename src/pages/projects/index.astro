---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import ProjectsToolbar from '../../components/sections/projects/ProjectsToolbar.astro';
import ProjectsCatalog from '../../components/sections/projects/ProjectsCatalog.astro';
import Products from '../../components/sections/Products.astro';
import Finishes from '../../components/sections/Finishes.astro';
import { about } from '../../config/about';
import { projects } from '../../config/projects';
---

<Layout title={projects.seoTitle} description={projects.seoDescription} canonical="/projects">
	<PageHero label={projects.label} title={projects.title} description={projects.description} />
	<ProjectsToolbar />
	<ProjectsCatalog />
	<Products mobileCarousel />
	<Finishes />
	<CtaBanner
		title={about.cta.title}
		description={about.cta.description}
		href={about.cta.href}
		label={about.cta.label}
	/>
</Layout>

<script>
	const search = document.getElementById('projects-search') as HTMLInputElement | null;
	const chips = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
	const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
	const countEl = document.getElementById('projects-count');
	const emptyEl = document.getElementById('projects-empty');
	const grid = document.getElementById('projects-grid');

	let activeCategory = 'All';

	const applyFilter = () => {
		const query = (search?.value ?? '').trim().toLowerCase();
		let visible = 0;
		const visibleCards: HTMLElement[] = [];

		cards.forEach((card) => {
			const title = card.dataset.title?.toLowerCase() ?? '';
			const category = card.dataset.category ?? '';
			const location = card.dataset.location?.toLowerCase() ?? '';
			const description = card.dataset.description?.toLowerCase() ?? '';
			const matchesCategory = activeCategory === 'All' || category === activeCategory;
			const matchesQuery =
				!query ||
				title.includes(query) ||
				location.includes(query) ||
				description.includes(query) ||
				category.toLowerCase().includes(query);
			const show = matchesCategory && matchesQuery;
			card.hidden = !show;
			card.classList.toggle('hidden', !show);
			if (show) {
				visible += 1;
				visibleCards.push(card);
			}
		});

		visibleCards.forEach((card, index) => {
			const isFeatured = index === 0 || index === visibleCards.length - 1;
			card.classList.toggle('col-span-full', isFeatured);
			card.dataset.featured = String(isFeatured);

			const img = card.querySelector('[data-project-image]');
			img?.classList.toggle('aspect-[2/1]', isFeatured);
			img?.classList.toggle('md:aspect-[21/9]', isFeatured);
			img?.classList.toggle('aspect-[4/5]', !isFeatured);

			const title = card.querySelector('[data-project-title]');
			title?.classList.toggle('text-2xl', isFeatured);
			title?.classList.toggle('sm:text-3xl', isFeatured);
			title?.classList.toggle('md:text-4xl', isFeatured);
			title?.classList.toggle('text-xl', !isFeatured);
			title?.classList.toggle('md:text-2xl', !isFeatured);

			const desc = card.querySelector('[data-project-desc]');
			desc?.classList.toggle('hidden', !isFeatured);

			const pad = card.querySelector('[data-project-pad]');
			pad?.classList.toggle('p-6', isFeatured);
			pad?.classList.toggle('md:p-10', isFeatured);
			pad?.classList.toggle('p-5', !isFeatured);
			pad?.classList.toggle('md:p-6', !isFeatured);
		});

		if (countEl) countEl.textContent = String(visible);
		if (emptyEl) {
			emptyEl.hidden = visible > 0;
			emptyEl.classList.toggle('hidden', visible > 0);
		}
		if (grid) grid.classList.toggle('hidden', visible === 0);
	};

	search?.addEventListener('input', applyFilter);

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			activeCategory = chip.dataset.categoryFilter ?? 'All';
			chips.forEach((other) => {
				const active = other === chip;
				other.setAttribute('aria-pressed', String(active));
				other.classList.toggle('border-primary-dark', active);
				other.classList.toggle('bg-primary-dark', active);
				other.classList.toggle('text-white', active);
				other.classList.toggle('border-border', !active);
				other.classList.toggle('text-heading', !active);
			});
			applyFilter();
		});
	});
</script>
